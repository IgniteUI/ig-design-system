{
  "name": "ig-design-system-site",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site of ig-design-system: the guide, the tokens, the logo and the documents.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check:tokens": "node ../checks/check-vars.ts ../dist/tokens.css ../dist/theme.css dist && node ../dist/cli/checks/cli.js check src",
    "verify": "npm run build && npm run check:tokens && npm test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.10",
    "@types/node": "^22.20.5",
    "astro": "^7.4.13",
    "playwright": "1.63.0",
    "satteri": "^0.11.7",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
