---
// The opening band of the guide: the rules of the design system in plain words, each linked to its examples, beside the drawing.
import ActionLink from "@/components/guide/ActionLink.astro";
import HeroArt from "@/components/guide/HeroArt.astro";
import { RULES, ruleId } from "@/data/rules.ts";
import { href } from "@/lib/paths.ts";

const WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten"];
const count = WORDS[RULES.length] ?? String(RULES.length);
---

<div class="hero">
  <div class="inner">
    <div class="text">
      <h1 class="igd-type-display-lg">{count} rules keep every Infragistics page consistent</h1>
      <p class="igd-type-lead">
        The design system names every colour, size and space by what it is for. Follow these rules and a page
        looks right in the light and the dark theme.
      </p>
      <ol>
        {
          RULES.map((rule, i) => (
            <li>
              <a href={`#${ruleId(i)}`}>
                <span class="number">{i + 1}</span>
                {rule.title}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="actions">
        <ActionLink href="#idea">Start with the idea</ActionLink>
        <ActionLink href={href("tokens/")} quiet>Browse every token</ActionLink>
      </div>
    </div>
    <div class="art"><HeroArt /></div>
  </div>
</div>

<style>
  .hero {
    background: var(--igd-color-surface-page);
    border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    align-items: center;
    gap: var(--igd-space-gap-4xl);
    max-inline-size: var(--igd-container-max-width);
    margin-inline: auto;
    padding: var(--igd-space-inset-5xl) var(--igd-container-gutter);
    container-type: inline-size;
  }

  .text {
    display: grid;
    gap: var(--igd-space-gap-lg);
  }

  h1 {
    max-inline-size: 18ch;
    text-wrap: balance;
  }

  .igd-type-lead {
    margin: 0;
    max-inline-size: 34rem;
    color: var(--igd-color-text-secondary);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-inline-size: 34rem;
    border-block-start: var(--igd-border-width-default) solid var(--igd-color-border-default);
  }

  li {
    border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-default);
  }

  li a {
    display: flex;
    align-items: baseline;
    gap: var(--igd-space-gap-md);
    padding: var(--igd-space-inset-sm) var(--igd-space-inset-xs);
    color: var(--igd-color-text-heading);
    font-size: var(--igd-type-body-lg-font-size);
    font-weight: var(--igd-font-weight-semibold);
    transition: background-color var(--igd-duration-fast) var(--igd-easing-default);
  }

  li a:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-action-text);
  }

  .number {
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-sm-font-size);
    color: var(--igd-color-action-text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-sm);
  }

  .art :global(svg) {
    inline-size: 100%;
    block-size: auto;
  }

  /* breakpoint-lg: the drawing is decoration, so a small screen leaves it out and keeps the rules. */
  @media (max-width: 1024px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--igd-space-inset-3xl);
    }

    .art {
      display: none;
    }
  }
</style>
