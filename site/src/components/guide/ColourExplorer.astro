---
// Picks a colour by its job: a list of colours by group, each with its use, beside a small drawn page, where every part
// that uses the picked colour is outlined.
import ExampleLayout from "@/components/guide/ExampleLayout.astro";
import ExampleTag from "@/components/guide/ExampleTag.astro";
import OptionList from "@/components/guide/OptionList.astro";
import { COLOUR_PICKS } from "@/data/guide.ts";
import { cssVar, prefixOf, tokens } from "@/lib/design-system.ts";
import { pick } from "@/lib/tokens.ts";

const groups = COLOUR_PICKS.filter((g) => g.id !== "colour-messages");
const picks = groups.flatMap((g) => g.picks);
pick(tokens.color.tokens, picks.map((p) => p.token), "colour");

// The parts of the drawing, by token. The build stops when a listed colour has no part or a part has no listed colour.
const PARTS = [
  "color-background-page",
  "color-background-band",
  "color-background-card",
  "color-background-tint",
  "color-foreground-heading",
  "color-foreground-default",
  "color-foreground-subtle",
  "color-foreground-faint",
  "color-foreground-action",
  "color-border-subtle",
  "color-border-control",
  "color-border-default",
  "color-background-action",
  "color-foreground-on-action",
  "color-background-action-hover",
  "color-background-inverse",
  "color-foreground-inverse",
  "color-foreground-inverse-faint",
  "color-foreground-link-inverse",
];
const unmatched = [
  ...picks.filter((p) => !PARTS.includes(p.token)).map((p) => p.token),
  ...PARTS.filter((t) => !picks.some((p) => p.token === t)),
];
if (unmatched.length)
  throw new Error(
    `The colour explorer draws no part for, or lists no colour for: ${unmatched.join(", ")}. Match COLOUR_PICKS in site/src/data/guide.ts and PARTS in ColourExplorer.astro.`,
  );

const first = "color-foreground-faint";
const part = (token: string) => ({ "data-part": token, "data-current": token === first ? "" : undefined });
---

<ExampleLayout class="explorer" data-explorer data-colour-explorer>
  <div class="options" slot="controls">
    {
      groups.map((group) => (
        <div class="colour-group">
          <p class="group-title" aria-hidden="true">{group.title}</p>
          <OptionList
            options={group.picks.map((p) => ({
              pick: p.token,
              label: p.label,
              use: p.use,
              swatch: `var(${cssVar(p.token)})`,
              name: { text: cssVar(p.token), prefix: prefixOf(cssVar(p.token)) },
            }))}
            first={first}
            label={group.title}
          />
        </div>
      ))
    }
  </div>


  <div class="drawing">
    <ExampleTag />
    <div aria-hidden="true">
    <div class="page" {...part("color-background-page")}>
      <div class="band" {...part("color-background-band")}>
        <div class="card" {...part("color-background-card")}>
          <span class="tint" {...part("color-background-tint")}>New</span>
          <span class="heading" {...part("color-foreground-heading")}>Project settings</span>
          <span class="strong" {...part("color-foreground-default")}>Choose who can edit this project.</span>
          <span class="body" {...part("color-foreground-subtle")}>
            Members can change the samples and the theme. Viewers can only read them.
          </span>
          <span class="muted" {...part("color-foreground-faint")}>Updated 2 hours ago</span>
          <span class="link" {...part("color-foreground-action")}>Read about roles</span>
          <span class="divider" {...part("color-border-subtle")} />
          <span class="row">
            <span class="field" {...part("color-border-control")}>Search members</span>
            <span class="chip" {...part("color-border-default")}>Angular</span>
          </span>
          <span class="row">
            <span class="button" {...part("color-background-action")}>
              <span {...part("color-foreground-on-action")}>Save</span>
            </span>
            <span class="button hover" {...part("color-background-action-hover")}>
              <span {...part("color-foreground-on-action")}>Hovered</span>
            </span>
          </span>
        </div>
      </div>
      <div class="footer" {...part("color-background-inverse")}>
        <span class="footer-title" {...part("color-foreground-inverse")}>Infragistics</span>
        <span {...part("color-foreground-inverse-faint")}>Stays dark in both variants</span>
        <span class="footer-link-foreground" {...part("color-foreground-link-inverse")}>Contact us</span>
      </div>
    </div>
    </div>
  </div>
</ExampleLayout>

<script>
  import "@/scripts/explorer.ts";
</script>

<style>
  .options {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-md);
  }


  .drawing {
    display: grid;
    gap: var(--igd-space-gap-xs);
    min-inline-size: 0;
  }

  .colour-group {
    display: grid;
    gap: var(--igd-space-gap-2xs);
  }

  .group-title {
    margin: 0;
    color: var(--igd-color-foreground-heading);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }



  /* Every part that uses the picked colour is outlined in the focus colour. */
  [data-part] {
    outline: var(--igd-focus-ring-width) solid transparent;
    outline-offset: var(--igd-focus-ring-offset);
    transition: outline-color var(--igd-duration-fast) var(--igd-easing-default);
  }

  [data-part][data-current] {
    outline-color: var(--igd-color-focus-ring);
  }

  .footer [data-part][data-current] {
    outline-color: var(--igd-color-focus-ring-inverse);
  }

  .page {
    display: grid;
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) dashed var(--igd-color-border-default);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-background-page);
    gap: var(--igd-space-gap-md);
  }

  .band {
    padding: var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-tile);
    background: var(--igd-color-background-band);
  }

  .card {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-xs);
    max-inline-size: 30rem;
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-background-card);
  }

  .tint {
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-xs);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-background-tint);
    color: var(--igd-color-foreground-action);
    font-size: var(--igd-type-body-2xs-font-size);
    font-weight: var(--igd-font-weight-semibold);
    text-transform: uppercase;
  }

  .heading {
    color: var(--igd-color-foreground-heading);
    font-family: var(--igd-font-display);
    font-size: var(--igd-type-title-sm-font-size);
    font-weight: var(--igd-font-weight-bold);
  }

  .strong {
    color: var(--igd-color-foreground-default);
    font-weight: var(--igd-font-weight-semibold);
  }

  .body {
    color: var(--igd-color-foreground-subtle);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .muted {
    color: var(--igd-color-foreground-faint);
    font-size: var(--igd-type-body-xs-font-size);
  }

  .link {
    color: var(--igd-color-foreground-action);
    font-weight: var(--igd-font-weight-semibold);
    text-decoration: underline;
  }

  .divider {
    align-self: stretch;
    block-size: var(--igd-border-width-default);
    background: var(--igd-color-border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--igd-space-gap-xs);
  }

  .field {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-sm);
    min-inline-size: 10rem;
    padding: 0 var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-badge);
    color: var(--igd-color-foreground-faint);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .chip {
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-action);
    color: var(--igd-color-foreground-control);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-background-action);
    color: var(--igd-color-foreground-on-action);
    font-weight: var(--igd-font-weight-semibold);
  }

  .button.hover {
    background: var(--igd-color-background-action-hover);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--igd-space-gap-xs) var(--igd-space-gap-md);
    padding: var(--igd-space-inset-md) var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-tile);
    background: var(--igd-color-background-inverse);
    color: var(--igd-color-foreground-inverse-faint);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .footer-title {
    color: var(--igd-color-foreground-inverse);
    font-weight: var(--igd-font-weight-semibold);
  }

  .footer-link-foreground {
    color: var(--igd-color-foreground-link-inverse);
    text-decoration: underline;
  }
</style>
