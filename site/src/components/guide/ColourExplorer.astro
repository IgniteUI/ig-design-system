---
// Picks a colour by its job: a list of colours by group beside a small drawn page, where every part that uses the picked
// colour is outlined, with its use and the name of its token above the page. A part of the page can be picked too.
import ExampleTag from "@/components/guide/ExampleTag.astro";
import CopyName from "@/components/ui/CopyName.astro";
import { COLOUR_PICKS } from "@/data/guide.ts";
import { cssVar, prefixOf, tokens } from "@/lib/design-system.ts";
import { pick } from "@/lib/tokens.ts";

const groups = COLOUR_PICKS.filter((g) => g.id !== "colour-messages");
const picks = groups.flatMap((g) => g.picks);
pick(tokens.color.tokens, picks.map((p) => p.token), "colour");

// The parts of the drawing, by token. The build stops when a listed colour has no part or a part has no listed colour.
const PARTS = [
  "color-surface-page",
  "color-surface-subtle",
  "color-surface-card",
  "color-surface-tint",
  "color-text-heading",
  "color-text-primary",
  "color-text-secondary",
  "color-text-muted",
  "color-action-text",
  "color-border-subtle",
  "color-border-control",
  "color-border-default",
  "color-action-default",
  "color-action-on",
  "color-action-fill-hover",
  "color-surface-inverse",
  "color-text-inverse",
  "color-text-inverse-muted",
  "color-link-inverse",
];
const unmatched = [
  ...picks.filter((p) => !PARTS.includes(p.token)).map((p) => p.token),
  ...PARTS.filter((t) => !picks.some((p) => p.token === t)),
];
if (unmatched.length)
  throw new Error(
    `The colour explorer draws no part for, or lists no colour for: ${unmatched.join(", ")}. Match COLOUR_PICKS in site/src/data/guide.ts and PARTS in ColourExplorer.astro.`,
  );

const first = "color-text-muted";
const part = (token: string) => ({ "data-part": token, "data-current": token === first ? "" : undefined });
---

<div class="explorer" data-explorer data-colour-explorer>
  <div class="options">
    {
      groups.map((group) => (
        <div class="colour-group" role="group" aria-labelledby={`${group.id}-pick`}>
          <p class="group-title" id={`${group.id}-pick`}>
            {group.title}
          </p>
          <div class="chips">
            {group.picks.map((p) => (
              <button type="button" data-pick={p.token} aria-pressed={p.token === first ? "true" : "false"}>
                <span class="swatch" style={`background: var(${cssVar(p.token)})`} />
                {p.label}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div class="info">
    {
      picks.map((p) => (
        <div data-info={p.token} hidden={p.token !== first}>
          <p class="use">{p.use}</p>
          <CopyName name={cssVar(p.token)} prefix={prefixOf(cssVar(p.token))} copy={`var(${cssVar(p.token)})`} />
        </div>
      ))
    }
  </div>

  <div class="drawing">
    <ExampleTag />
    <div aria-hidden="true">
    <div class="page" {...part("color-surface-page")}>
      <div class="band" {...part("color-surface-subtle")}>
        <div class="card" {...part("color-surface-card")}>
          <span class="tint" {...part("color-surface-tint")}>New</span>
          <span class="heading" {...part("color-text-heading")}>Project settings</span>
          <span class="strong" {...part("color-text-primary")}>Choose who can edit this project.</span>
          <span class="body" {...part("color-text-secondary")}>
            Members can change the samples and the theme. Viewers can only read them.
          </span>
          <span class="muted" {...part("color-text-muted")}>Updated 2 hours ago</span>
          <span class="link" {...part("color-action-text")}>Read about roles</span>
          <span class="divider" {...part("color-border-subtle")} />
          <span class="row">
            <span class="field" {...part("color-border-control")}>Search members</span>
            <span class="chip" {...part("color-border-default")}>Angular</span>
          </span>
          <span class="row">
            <span class="button" {...part("color-action-default")}>
              <span {...part("color-action-on")}>Save</span>
            </span>
            <span class="button hover" {...part("color-action-fill-hover")}>
              <span {...part("color-action-on")}>Hovered</span>
            </span>
          </span>
        </div>
      </div>
      <div class="footer" {...part("color-surface-inverse")}>
        <span class="footer-title" {...part("color-text-inverse")}>Infragistics</span>
        <span {...part("color-text-inverse-muted")}>Stays dark in both variants</span>
        <span class="footer-link" {...part("color-link-inverse")}>Contact us</span>
      </div>
    </div>
    </div>
  </div>
</div>

<script>
  import "@/scripts/explorer.ts";
</script>

<style>
  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "options" "info" "drawing";
    gap: var(--igd-space-gap-md);
    margin-block-end: var(--igd-space-stack-2xl);
  }

  /* breakpoint-lg: the list of colours sits beside the page. */
  @media (min-width: 1024px) {
    .explorer {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
      grid-template-areas: "options info" "options drawing";
      grid-template-rows: auto 1fr;
    }
  }

  .options {
    grid-area: options;
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-md);
  }

  .info {
    grid-area: info;
    min-inline-size: 0;
  }

  .drawing {
    grid-area: drawing;
    display: grid;
    gap: var(--igd-space-gap-xs);
    min-inline-size: 0;
  }

  .colour-group {
    display: grid;
    gap: var(--igd-space-gap-2xs);
  }

  .group-title {
    margin: 0;
    color: var(--igd-color-text-heading);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-2xs);
  }

  .chips button {
    display: inline-flex;
    align-items: center;
    gap: var(--igd-space-gap-2xs);
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-sm) 0 var(--igd-space-inset-xs);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    background: transparent;
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
  }

  .chips button:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-text-heading);
  }

  .chips button[aria-pressed="true"] {
    border-color: var(--igd-color-action-default);
    background: var(--igd-color-surface-tint);
    color: var(--igd-color-action-text);
  }

  @media (pointer: coarse) {
    .chips button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  .swatch {
    flex: none;
    inline-size: var(--igd-size-icon-sm);
    block-size: var(--igd-size-icon-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-full);
  }

  .info > div {
    display: grid;
    gap: var(--igd-space-gap-3xs);
  }

  .use {
    margin: 0;
    color: var(--igd-color-text-primary);
    font-weight: var(--igd-font-weight-semibold);
  }

  /* Every part that uses the picked colour is outlined in the focus colour. */
  [data-part] {
    outline: var(--igd-focus-ring-width) solid transparent;
    outline-offset: var(--igd-focus-ring-offset);
    transition: outline-color var(--igd-duration-fast) var(--igd-easing-default);
    cursor: pointer;
  }

  [data-part][data-current] {
    outline-color: var(--igd-color-focus-default);
  }

  .footer [data-part][data-current] {
    outline-color: var(--igd-color-focus-inverse);
  }

  .page {
    display: grid;
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) dashed var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-page);
    gap: var(--igd-space-gap-md);
  }

  .band {
    padding: var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-md);
    background: var(--igd-color-surface-subtle);
  }

  .card {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-xs);
    max-inline-size: 30rem;
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-card);
  }

  .tint {
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-xs);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-surface-tint);
    color: var(--igd-color-action-text);
    font-size: var(--igd-type-body-2xs-font-size);
    font-weight: var(--igd-font-weight-semibold);
    text-transform: uppercase;
  }

  .heading {
    color: var(--igd-color-text-heading);
    font-family: var(--igd-font-display);
    font-size: var(--igd-type-title-sm-font-size);
    font-weight: var(--igd-font-weight-bold);
  }

  .strong {
    color: var(--igd-color-text-primary);
    font-weight: var(--igd-font-weight-semibold);
  }

  .body {
    color: var(--igd-color-text-secondary);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .muted {
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-body-xs-font-size);
  }

  .link {
    color: var(--igd-color-action-text);
    font-weight: var(--igd-font-weight-semibold);
    text-decoration: underline;
  }

  .divider {
    align-self: stretch;
    block-size: var(--igd-border-width-default);
    background: var(--igd-color-border-subtle);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--igd-space-gap-xs);
  }

  .field {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-sm);
    min-inline-size: 10rem;
    padding: 0 var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-sm);
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .chip {
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-full);
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-weight: var(--igd-font-weight-semibold);
  }

  .button.hover {
    background: var(--igd-color-action-fill-hover);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--igd-space-gap-xs) var(--igd-space-gap-md);
    padding: var(--igd-space-inset-md) var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-md);
    background: var(--igd-color-surface-inverse);
    color: var(--igd-color-text-inverse-muted);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .footer-title {
    color: var(--igd-color-text-inverse);
    font-weight: var(--igd-font-weight-semibold);
  }

  .footer-link {
    color: var(--igd-color-link-inverse);
    text-decoration: underline;
  }
</style>
