---
// A panel that shows a component, optionally in its own theme or as a scope that carries dials.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** A caption above the component, in the mono face. */
  label?: string;
}

const { label, ...rest } = Astro.props;
---

<div data-ig-scope class="stage" {...rest}>
  {label && <span class="tag">{label}</span>}
  <slot />
</div>

<style>
  .stage {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-background-subtle);
    color: var(--igd-color-foreground-default);
  }
</style>
