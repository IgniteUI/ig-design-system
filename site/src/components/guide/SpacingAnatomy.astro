---
// A drawing of the three spacing roles: inset inside a box, gap between items, stack between blocks.
---

<div class="box" aria-hidden="true">
  <span class="tag">Padding: space inside a box</span>
  <div class="row"><span class="item">Item</span><span class="tag">Gap: between items</span><span class="item">Item</span></div>
  <span class="tag stack">Margin: between blocks</span>
  <div class="row"><span class="item">Item</span><span class="item">Item</span></div>
</div>

<style>
  .box {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-2xs);
    max-inline-size: 32rem;
    margin-block-end: var(--igd-space-stack-xl);
    padding: var(--igd-space-inset-xl);
    border: var(--igd-border-width-strong) dashed var(--igd-color-border-accent);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-tint);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--igd-space-gap-xs);
  }

  .item {
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-sm);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  .tag {
    color: var(--igd-color-action-text);
  }

  .stack {
    padding-block: var(--igd-space-inset-xs);
  }
</style>
