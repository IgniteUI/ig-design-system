---
// Four messages as a site shows them: an icon and a title in the message colour, a short text, on the message's own tint.
const MESSAGES = [
  {
    kind: "error",
    title: "Payment failed",
    text: "Your card was declined. Check the card number, or try another card.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/>',
  },
  {
    kind: "success",
    title: "Changes saved",
    text: "Your project settings are up to date. Everyone on the team sees them now.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>',
  },
  {
    kind: "warning",
    title: "Your trial ends in 3 days",
    text: "Choose a plan to keep your projects and samples.",
    icon: '<path d="M12 3.5 2.5 20h19L12 3.5Z"/><path d="M12 10v4.5M12 17.25v.25"/>',
  },
  {
    kind: "info",
    title: "A new version is out",
    text: "The grid can now filter by more than one column. Read what changed.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.75v.25"/>',
  },
];
---

<ul class="messages">
  {
    MESSAGES.map((m) => (
      <li class={m.kind} data-token={`color-feedback-${m.kind}-default`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={m.icon} />
        <div>
          <p class="title">{m.title}</p>
          <p>{m.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .messages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--igd-space-gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: start;
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-md);
    color: var(--igd-color-text-primary);
  }

  .error {
    --tone: var(--igd-color-feedback-error-default);
    background: var(--igd-color-feedback-error-surface);
  }

  .success {
    --tone: var(--igd-color-feedback-success-default);
    background: var(--igd-color-feedback-success-surface);
  }

  .warning {
    --tone: var(--igd-color-feedback-warning-default);
    background: var(--igd-color-feedback-warning-surface);
  }

  .info {
    --tone: var(--igd-color-feedback-info-default);
    background: var(--igd-color-feedback-info-surface);
  }

  svg {
    flex: none;
    inline-size: var(--igd-size-icon-lg);
    block-size: var(--igd-size-icon-lg);
    fill: none;
    stroke: var(--tone);
    stroke-width: var(--igd-size-icon-stroke-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  p {
    margin: 0;
    font-size: var(--igd-type-body-sm-font-size);
    line-height: var(--igd-type-body-sm-line-height);
  }

  .title {
    color: var(--tone);
    font-weight: var(--igd-font-weight-semibold);
  }
</style>
