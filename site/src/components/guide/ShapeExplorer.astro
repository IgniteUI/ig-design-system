---
// Picks a corner or a shadow by what it sits on: a row of options and a drawing that shows the chosen one, in plain words.
// For corners the drawing is a small interface whose parts can be picked too; for shadows it is one card that lifts.
import { SHAPE_PICKS } from "@/data/guide.ts";
import { cssVar, tokens } from "@/lib/design-system.ts";
import { pick } from "@/lib/tokens.ts";

interface Props {
  kind: "radius" | "shadow";
}

const { kind } = Astro.props;
const picks = SHAPE_PICKS[kind];
pick(kind === "radius" ? tokens.radius.tokens : tokens.shadow.tokens, picks.map((p) => p.token), kind);
const first = kind === "radius" ? "radius-lg" : "shadow-raised";
const part = (token: string) => ({ "data-part": token, "data-current": token === first ? "" : undefined });
---

<div class:list={["explorer", kind]} data-shape-explorer>
  <div class="body">
  <div class="options" role="group" aria-label={kind === "radius" ? "Corner of" : "Shadow of"}>
    {
      picks.map((p) => (
        <button type="button" data-pick={p.token} aria-pressed={p.token === first ? "true" : "false"}>
          {kind === "shadow" ? (
            <>
              <strong>{p.label}</strong>
              <span class="meaning">{p.use}</span>
            </>
          ) : (
            p.label
          )}
        </button>
      ))
    }
  </div>

  <div class="drawing" aria-hidden="true">
    {
      kind === "radius" ? (
        <div class="large" {...part("radius-xl")}>
          <div class="card" {...part("radius-lg")}>
            <span class="badge" {...part("radius-sm")}>New</span>
            <strong>Project settings</strong>
            <span class="row on" {...part("radius-md")}>General</span>
            <span class="row">Members</span>
            <span class="check">
              <span class="box" {...part("radius-xs")} />
              Email me about changes
            </span>
            <span class="button" {...part("radius-full")}>Save changes</span>
          </div>
        </div>
      ) : (
        <div class="lifted" data-lift style={`box-shadow: var(${cssVar(first)})`}>
          <strong>A card</strong>
          <span>It lifts to the shadow you pick.</span>
        </div>
      )
    }
  </div>

  {
    kind === "radius" && (
      <div class="info">
        {picks.map((p) => (
          <p class="use" data-info={p.token} hidden={p.token !== first}>
            {p.use}
          </p>
        ))}
      </div>
    )
  }
  </div>
</div>

<script>
  import "@/scripts/shape.ts";
</script>

<style>
  .explorer {
    display: grid;
    gap: var(--igd-space-gap-md);
    container-type: inline-size;
  }

  /* The token of the pick sits above the drawing at every width. The shadow options, each with its meaning,
     form a list beside the card where there is room. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "options" "info" "drawing";
    gap: var(--igd-space-gap-md);
  }

  .shadow .body {
    grid-template-areas: "options" "drawing";
  }

  .options {
    grid-area: options;
  }

  .drawing {
    grid-area: drawing;
  }

  /* A grid item takes the width of its widest line by default; a code sample scrolls inside it instead. */
  .options,
  .drawing,
  .info {
    min-inline-size: 0;
  }

  .info {
    grid-area: info;
  }

  @container (inline-size >= 40rem) {
    .shadow .body {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
      grid-template-areas: "options drawing";
    }
  }

  .shadow .options {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-xs);
  }

  .shadow .options button {
    display: grid;
    gap: var(--igd-space-gap-3xs);
    padding: var(--igd-space-inset-sm) var(--igd-space-inset-md);
    border-radius: var(--igd-radius-md);
    text-align: start;
  }

  .meaning {
    font-size: var(--igd-type-body-xs-font-size);
    line-height: var(--igd-type-body-xs-line-height);
    font-weight: var(--igd-font-weight-regular);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-xs);
  }

  .options button {
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    background: transparent;
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
  }

  .options button:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-text-heading);
  }

  .options button[aria-pressed="true"] {
    border-color: var(--igd-color-action-default);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
  }

  @media (pointer: coarse) {
    .options button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  .drawing {
    display: grid;
    place-items: center;
    padding: var(--igd-space-inset-2xl) var(--igd-space-inset-md);
    border: var(--igd-border-width-default) dashed var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
  }

  /* The picked part is outlined in the focus colour, so its corner reads against the rest. */
  [data-part] {
    outline: var(--igd-focus-ring-width) solid transparent;
    outline-offset: var(--igd-focus-ring-offset);
    transition: outline-color var(--igd-duration-fast) var(--igd-easing-default);
    cursor: pointer;
  }

  [data-part][data-current] {
    outline-color: var(--igd-color-focus-default);
  }

  .large {
    display: grid;
    inline-size: min(100%, 26rem);
    padding: var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-xl);
    background: var(--igd-color-surface-tint);
  }

  .card {
    display: grid;
    gap: var(--igd-space-gap-xs);
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-primary);
  }

  .card strong {
    color: var(--igd-color-text-heading);
  }

  .badge {
    justify-self: start;
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-xs);
    border-radius: var(--igd-radius-sm);
    background: var(--igd-badge-new-background);
    color: var(--igd-badge-new-color);
    font-size: var(--igd-type-body-2xs-font-size);
    font-weight: var(--igd-font-weight-semibold);
    text-transform: uppercase;
  }

  .row {
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-sm);
    border-radius: var(--igd-radius-md);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .row.on {
    background: var(--igd-color-surface-tint);
    color: var(--igd-color-action-text);
    font-weight: var(--igd-font-weight-semibold);
  }

  .check {
    display: flex;
    align-items: center;
    gap: var(--igd-space-gap-xs);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .box {
    flex: none;
    inline-size: var(--igd-size-icon-md);
    block-size: var(--igd-size-icon-md);
    border: var(--igd-border-width-strong) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-xs);
  }

  .button {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-md);
    margin-block-start: var(--igd-space-stack-2xs);
    padding: 0 var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-weight: var(--igd-font-weight-semibold);
  }

  .lifted {
    display: grid;
    gap: var(--igd-space-gap-2xs);
    inline-size: min(100%, 20rem);
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-secondary);
    transition: box-shadow var(--igd-duration-slow) var(--igd-easing-default);
  }

  .shadow .drawing {
    padding-block: var(--igd-space-inset-4xl);
  }

  .lifted strong {
    color: var(--igd-color-text-heading);
  }


  .use {
    margin: 0;
    color: var(--igd-color-text-primary);
    font-weight: var(--igd-font-weight-semibold);
  }
</style>
