---
// An interactive example of the guide: its controls on the left, and what they change on the right, the info above the drawing.
// Below 48rem of content width the three stack in that order. Attributes and the class go on the root element.
interface Props {
  class?: string;
  [attribute: string]: unknown;
}

const { class: className, ...attributes } = Astro.props;
---

<div class="frame">
  <div class:list={["example", className]} data-example-layout {...attributes}>
    <div class="controls"><slot name="controls" /></div>
    <div class="result">
      <slot name="info" />
      <slot />
    </div>
  </div>
</div>

<style>
  .frame {
    container-type: inline-size;
  }

  .example {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--igd-space-gap-lg);
  }

  .controls,
  .result {
    display: flex;
    flex-direction: column;
    gap: var(--igd-space-gap-md);
    min-inline-size: 0;
  }

  /* The drawing fills the height beside its controls. */
  .result > :global(:last-child) {
    flex: 1;
  }

  @container (inline-size >= 48rem) {
    .example {
      grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr);
    }
  }
</style>
