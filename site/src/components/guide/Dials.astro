---
// A control panel beside the live card: each dial is one row of options that sets it on the card, with its default named below.
import ExampleLayout from "@/components/guide/ExampleLayout.astro";
import { DIALS } from "@/data/guide.ts";

interface Props {
  /** The id of the element the dials are set on, passed in the slot. */
  target: string;
}

const { target } = Astro.props;
const defaultOf = (values: [string, string][]) => values.find(([, value]) => value === "")?.[0];
---

<ExampleLayout class="lab">
  <div class="panel" slot="controls" data-dials={target}>
    {
      DIALS.map((dial) => (
        <div class="dial">
          <p class="name" id={`dial-${dial.label.toLowerCase()}`}>
            {dial.label} <code>{dial.property}</code>
          </p>
          <div class="options" role="group" aria-labelledby={`dial-${dial.label.toLowerCase()}`}>
            {dial.values.map(([label, value]) => (
              <button
                type="button"
                data-dial={dial.property}
                data-value={value}
                aria-pressed={value === "" ? "true" : "false"}
              >
                {label}
              </button>
            ))}
          </div>
          <p class="default">
            Default: {defaultOf(dial.values)}.{dial.note && ` ${dial.note}`}
          </p>
        </div>
      ))
    }
    <button type="button" class="reset" data-dial-reset>Reset the dials</button>
  </div>
  <div class="stage-slot"><slot /></div>
</ExampleLayout>

<script>
  import "@/scripts/dials.ts";
</script>

<style>
  /* The examples fill their stage, a dashed outline with no fill of its own, so a change of padding or corner shows across their whole width. */
  .stage-slot > :global(.stage) {
    justify-items: stretch;
    border-style: dashed;
    border-color: var(--igd-color-border-default);
    background: transparent;
  }

  .stage-slot > :global(.stage .card) {
    max-inline-size: none;
  }

  .panel {
    display: grid;
    gap: var(--igd-space-gap-lg);
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-surface-card);
  }

  .dial {
    display: grid;
    gap: var(--igd-space-gap-xs);
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--igd-space-gap-xs);
    margin: 0;
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  .name code {
    color: var(--igd-color-text-muted);
    font-weight: var(--igd-font-weight-regular);
  }

  /* One choice: the options are joined into a single control, and the chosen one is filled. */
  .options {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--igd-space-gap-3xs);
    padding: var(--igd-space-inset-3xs);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-surface-subtle);
  }

  .options button {
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-sm);
    border: 0;
    border-radius: var(--igd-radius-action);
    background: transparent;
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
    transition:
      background-color var(--igd-duration-fast) var(--igd-easing-default),
      color var(--igd-duration-fast) var(--igd-easing-default);
  }

  .options button:hover {
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-heading);
  }

  .options button[aria-pressed="true"] {
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
  }

  .options button:focus-visible {
    position: relative;
  }

  @media (pointer: coarse) {
    .options button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  .default {
    margin: 0;
    color: var(--igd-color-text-body);
    font-size: var(--igd-type-body-xs-font-size);
    line-height: var(--igd-type-body-xs-line-height);
  }

  .reset {
    justify-self: start;
    min-block-size: var(--igd-space-xl);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--igd-color-action-text);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
  }

  .reset:hover {
    color: var(--igd-color-action-hover);
  }
</style>
