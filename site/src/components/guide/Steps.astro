---
// A numbered list of steps. Each child is an <li>; a <strong> at its start is the name of the step.
---

<ol><slot /></ol>

<style>
  ol {
    margin: 0 0 var(--igd-space-stack-xl);
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--igd-space-gap-md);
    max-inline-size: var(--igd-container-prose-max-width);
  }

  ol > :global(li) {
    counter-increment: step;
    position: relative;
    min-inline-size: 0;
    padding-inline-start: var(--igd-space-inset-4xl);
    color: var(--igd-color-text-secondary);
  }

  ol > :global(li)::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    display: grid;
    place-items: center;
    inline-size: var(--igd-space-2xl);
    aspect-ratio: 1;
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-surface-tint);
    color: var(--igd-color-action-text);
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  ol :global(strong) {
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  ol :global(.code) {
    margin-block-start: var(--igd-space-stack-xs);
  }
</style>
