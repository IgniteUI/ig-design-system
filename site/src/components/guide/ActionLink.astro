---
// A link drawn as a button: filled in the action colour, or quiet with an outline.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  quiet?: boolean;
}

const { quiet = false, ...rest } = Astro.props;
---

<a class:list={{ quiet }} {...rest}><slot /></a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-lg);
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) solid var(--igd-color-action-default);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-size: var(--igd-type-label-md-font-size);
    font-weight: var(--igd-type-label-md-font-weight);
    transition:
      background-color var(--igd-duration-button) var(--igd-easing-default),
      border-color var(--igd-duration-button) var(--igd-easing-default);
  }

  a:hover {
    background: var(--igd-color-action-fill-hover);
    border-color: var(--igd-color-action-fill-hover);
    color: var(--igd-color-action-on);
  }

  .quiet {
    background: transparent;
    border-color: var(--igd-color-border-default);
    color: var(--igd-color-text-ui);
  }

  .quiet:hover {
    background: var(--igd-color-surface-subtle);
    border-color: var(--igd-color-border-control);
    color: var(--igd-color-text-heading);
  }
</style>
