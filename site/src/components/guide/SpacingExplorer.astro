---
// Shows the three kinds of space on two drawn cards: pick padding, margin or gap and that space is filled with a striped tint
// where it sits, with its use and the name of its token above.
import ExampleTag from "@/components/guide/ExampleTag.astro";
import CopyName from "@/components/ui/CopyName.astro";
import { cssVar, prefixOf, tokens } from "@/lib/design-system.ts";
import { pick } from "@/lib/tokens.ts";

const KINDS = [
  { id: "padding", label: "Padding", token: "space-inset-lg", use: "Space inside a box, between its edge and its content." },
  { id: "margin", label: "Margin", token: "space-stack-md", use: "Space between two blocks, one above the other." },
  { id: "gap", label: "Gap", token: "space-gap-sm", use: "Space between items in a row or a grid." },
];
pick(tokens.spacing.tokens, KINDS.map((k) => k.token), "spacing");
const first = "padding";
const part = (id: string) => ({ "data-part": id, "data-current": id === first ? "" : undefined });
---

<div class="explorer" data-explorer data-spacing-explorer>
  <div class="options" role="group" aria-label="Kind of space">
    {
      KINDS.map((k) => (
        <button type="button" data-pick={k.id} aria-pressed={k.id === first ? "true" : "false"}>
          <span class:list={["key", k.id]} />
          {k.label}
        </button>
      ))
    }
  </div>

  <div class="info">
    {
      KINDS.map((k) => (
        <div data-info={k.id} hidden={k.id !== first}>
          <p class="use">{k.use}</p>
          <CopyName name={cssVar(k.token)} prefix={prefixOf(cssVar(k.token))} copy={`var(${cssVar(k.token)})`} />
        </div>
      ))
    }
  </div>

  <div class="drawing">
    <ExampleTag many />
    <div class="stack" aria-hidden="true" {...part("margin")}>
      <div class="card" {...part("padding")}>
        <span class="title">Project settings</span>
        <span class="text">Choose who can edit the samples and the theme.</span>
        <span class="row" {...part("gap")}>
          <span class="button">Save</span>
          <span class="button quiet">Cancel</span>
        </span>
      </div>
      <div class="card" {...part("padding")}>
        <span class="title">Billing</span>
        <span class="text">Your plan renews on 1 March.</span>
      </div>
    </div>
  </div>
</div>

<script>
  import "@/scripts/explorer.ts";
</script>

<style>
  .explorer {
    --stripes: repeating-linear-gradient(
      -45deg,
      var(--igd-color-border-accent) 0 var(--igd-space-3xs),
      var(--igd-color-surface-tint) var(--igd-space-3xs) var(--igd-space-xs)
    );

    display: grid;
    gap: var(--igd-space-gap-md);
    margin-block-end: var(--igd-space-stack-lg);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-xs);
  }

  .options button {
    display: inline-flex;
    align-items: center;
    gap: var(--igd-space-gap-xs);
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-md) 0 var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    background: transparent;
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
  }

  .options button:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-text-heading);
  }

  .options button[aria-pressed="true"] {
    border-color: var(--igd-color-action-default);
    background: var(--igd-color-surface-tint);
    color: var(--igd-color-action-text);
  }

  @media (pointer: coarse) {
    .options button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  /* The key is a swatch of the stripes that mark the space. */
  .key {
    inline-size: var(--igd-size-icon-sm);
    block-size: var(--igd-size-icon-sm);
    border-radius: var(--igd-radius-xs);
    background: var(--stripes);
  }

  .info > div {
    display: grid;
    gap: var(--igd-space-gap-3xs);
  }

  .use {
    margin: 0;
    color: var(--igd-color-text-primary);
    font-weight: var(--igd-font-weight-semibold);
  }

  .drawing {
    display: grid;
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-md) var(--igd-space-inset-md) var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) dashed var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
  }

  .stack {
    display: grid;
    justify-self: center;
    inline-size: min(100%, 26rem);
    border-radius: var(--igd-radius-lg);
    transition: background-color var(--igd-duration-fast) var(--igd-easing-default);
  }

  .card {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-xs);
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-card);
  }

  .card + .card {
    margin-block-start: var(--igd-space-stack-md);
  }

  .title {
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  .text {
    color: var(--igd-color-text-secondary);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-sm);
    margin-block-start: var(--igd-space-stack-2xs);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--igd-size-control-sm);
    padding: 0 var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-action-default);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-weight: var(--igd-font-weight-semibold);
  }

  .button.quiet {
    background: var(--igd-color-surface-card);
    color: var(--igd-color-action-text);
  }

  /* Padding: a frame of stripes as wide as the padding, inside the card's border. */
  .card[data-current] {
    background:
      linear-gradient(var(--igd-color-surface-card), var(--igd-color-surface-card)) content-box,
      var(--stripes) padding-box;
  }

  /* Margin: the stack shows stripes, and only the space between the cards is not covered by a card. */
  .stack[data-current] {
    background: var(--stripes);
  }

  /* Gap: the row shows stripes, and only the space between the buttons is not covered by a button. */
  .row[data-current] {
    background: var(--stripes);
    border-radius: var(--igd-radius-full);
  }
</style>
