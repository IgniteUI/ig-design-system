---
// The menu of a section of the site, such as the Guide or Tokens: its pages, the open one marked.
// A list on the left; a wrapping row above the page below breakpoint-lg.
import { MENUS, type MenuId } from "@/data/navigation.ts";
import { href } from "@/lib/paths.ts";

interface Props {
  menu: MenuId;
}

const { title, pages } = MENUS[Astro.props.menu];
const here = Astro.url.pathname;
---

<nav data-ig-scope class="side-nav" aria-label={title}>
  <p class="title">{title}</p>
  <ul>
    {
      pages.map((page) => (
        <li>
          <a href={href(page.path)} aria-current={here === href(page.path) ? "page" : undefined}>
            {page.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .side-nav {
    grid-area: pages;
    align-self: start;
    position: sticky;
    inset-block-start: calc(var(--igd-nav-height) + var(--notice-block-size, 0px) + var(--igd-space-stack-xl));
  }

  .title {
    margin: 0 0 var(--igd-space-stack-xs);
    padding-inline: var(--igd-space-inset-sm);
    color: var(--igd-color-foreground-faint);
    font-size: var(--igd-type-eyebrow-font-size);
    font-weight: var(--igd-font-weight-semibold);
    letter-spacing: var(--igd-letter-spacing-label);
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--igd-space-gap-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-sm);
    border-radius: var(--igd-radius-control);
    color: var(--igd-color-foreground-subtle);
    font-size: var(--igd-type-body-sm-font-size);
  }

  @media (hover: hover) {
    a:hover {
      color: var(--igd-color-foreground-heading);
      background: var(--igd-color-background-subtle);
    }
  }

  /* The open page, as the top bar marks it. */
  a[aria-current="page"] {
    color: var(--igd-color-foreground-action);
    background: var(--igd-color-background-tint);
    font-weight: var(--igd-font-weight-semibold);
  }

  /* breakpoint-lg */
  @media (max-width: 1024px) {
    .side-nav {
      position: static;
      padding-block: var(--igd-space-inset-md) var(--igd-space-inset-sm);
      border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-default);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--igd-space-gap-3xs) var(--igd-space-gap-xs);
    }
  }

  @media (pointer: coarse) {
    a {
      display: flex;
      align-items: center;
      min-block-size: var(--igd-size-control-lg);
    }
  }
</style>
