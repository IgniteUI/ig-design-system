---
// The menu of the Guide: its pages and documents, the open one marked. A list on the left; a wrapping row above the page below breakpoint-lg.
import { GUIDE_PAGES } from "@/data/navigation.ts";
import { href } from "@/lib/paths.ts";

const here = Astro.url.pathname;
---

<nav class="guide-nav" aria-label="Guide">
  <p class="title">Guide</p>
  <ul>
    {
      GUIDE_PAGES.map((page) => (
        <li>
          <a href={href(page.path)} aria-current={here === href(page.path) ? "page" : undefined}>
            {page.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .guide-nav {
    grid-area: pages;
    align-self: start;
  }

  .title {
    margin: 0 0 var(--igd-space-stack-xs);
    padding-inline: var(--igd-space-inset-sm);
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-eyebrow-font-size);
    font-weight: var(--igd-font-weight-semibold);
    letter-spacing: var(--igd-letter-spacing-label);
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--igd-space-gap-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-sm);
    border-radius: var(--igd-radius-control);
    color: var(--igd-color-text-body);
    font-size: var(--igd-type-body-sm-font-size);
  }

  @media (hover: hover) {
    a:hover {
      color: var(--igd-color-text-heading);
      background: var(--igd-color-surface-muted);
    }
  }

  a[aria-current="page"] {
    color: var(--igd-color-text-heading);
    background: var(--igd-color-surface-muted);
    font-weight: var(--igd-font-weight-semibold);
  }

  /* breakpoint-lg */
  @media (max-width: 1024px) {
    .guide-nav {
      padding-block: var(--igd-space-inset-md) var(--igd-space-inset-sm);
      border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-default);
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--igd-space-gap-3xs) var(--igd-space-gap-xs);
    }
  }

  @media (pointer: coarse) {
    a {
      display: flex;
      align-items: center;
      min-block-size: var(--igd-size-control-lg);
    }
  }
</style>
