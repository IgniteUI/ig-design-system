---
// The section list of a page. It marks the section in view, and takes a control above the list through its slot.
interface Props {
  /** The sections, in order. A section with `sub` is a part of the section before it. */
  sections: { id: string; title: string; count?: number; unit?: string; sub?: boolean; soon?: boolean }[];
  /** A heading above the list, such as "On this page". It also names the list. */
  heading?: string;
}

const { sections, heading } = Astro.props;
---

<nav data-ig-scope aria-label={heading ?? "Sections"} data-section-nav>
  {heading && <p class="heading">{heading}</p>}
  <slot />
  <ul class="sections" data-section-list>
    {
      sections.map((section) => (
        <li class:list={{ sub: section.sub }}>
          <a href={`#${section.id}`}>
            <span>{section.title}</span>
            {section.soon && <span class="soon">Soon</span>}
            {section.count !== undefined && (
              <span class="count" data-count={section.count}>
                {section.count}
                <span class="sr"> {section.unit ?? "tokens"}</span>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import "@/scripts/scrollspy.ts";
</script>

<style>
  nav {
    position: sticky;
    inset-block-start: calc(var(--igd-nav-height) + var(--notice-block-size, 0px) + var(--igd-space-stack-xl));
    align-self: start;
    max-block-size: calc(100dvb - var(--igd-nav-height) - var(--notice-block-size, 0px) - var(--igd-space-stack-xl) * 2);
    overflow-y: auto;
    /* Room inside the scrolling box for the focus ring of the controls at its edges. */
    padding: calc(var(--igd-focus-ring-width) + var(--igd-focus-ring-offset));
    margin: calc(-1 * calc(var(--igd-focus-ring-width) + var(--igd-focus-ring-offset)));
  }

  .heading {
    margin: 0 0 var(--igd-space-stack-xs);
    padding-inline: var(--igd-space-inset-sm);
    color: var(--igd-color-foreground-faint);
    font-size: var(--igd-type-eyebrow-font-size);
    font-weight: var(--igd-font-weight-semibold);
    letter-spacing: var(--igd-letter-spacing-label);
    text-transform: uppercase;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--igd-space-gap-3xs);
  }

  /* Positioned, so the text for assistive technology stays inside the row when it scrolls sideways. */
  li a {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-sm);
    border-radius: var(--igd-radius-control);
    color: var(--igd-color-foreground-subtle);
    font-size: var(--igd-type-body-sm-font-size);
  }

  li.sub a {
    padding-inline-start: var(--igd-space-inset-xl);
  }

  @media (hover: hover) {
    li a:hover {
      color: var(--igd-color-foreground-heading);
      background: var(--igd-color-background-subtle);
    }
  }

  /* The section being read, as the top bar marks the open page. */
  .sections a.current,
  .sections a.current:hover {
    background: var(--igd-color-background-tint);
    color: var(--igd-color-foreground-action);
    font-weight: var(--igd-font-weight-semibold);
  }

  .sections a.current :is(.count, .soon) {
    border-color: currentColor;
    color: inherit;
  }

  /* breakpoint-lg: one row under the top bar that stays in view and scrolls sideways. */
  @media (max-width: 1024px) {
    nav {
      inset-block-start: calc(var(--igd-nav-height) + var(--notice-block-size, 0px));
      z-index: var(--igd-z-index-sticky);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: var(--igd-space-gap-xs);
      max-block-size: none;
      overflow: visible;
      margin: 0 calc(-1 * var(--igd-container-gutter));
      padding: var(--igd-space-inset-xs) var(--igd-container-gutter);
      background: var(--igd-color-background-page);
      border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-default);
    }

    .heading {
      display: none;
    }

    /* A soft edge shows on the side that has more of the row to scroll to. */
    .sections {
      min-inline-size: 0;
      /* Room inside the scrolling row for the focus ring of its links. */
      padding: calc(var(--igd-focus-ring-width) + var(--igd-focus-ring-offset));
      margin: calc(-1 * calc(var(--igd-focus-ring-width) + var(--igd-focus-ring-offset)));
      display: flex;
      gap: var(--igd-space-gap-2xs);
      overflow-x: auto;
      scrollbar-width: none;
      background:
        linear-gradient(90deg, var(--igd-color-background-page) 30%, transparent) left / var(--igd-space-2xl) 100% no-repeat local,
        linear-gradient(270deg, var(--igd-color-background-page) 30%, transparent) right / var(--igd-space-2xl) 100% no-repeat local,
        linear-gradient(90deg, var(--igd-color-border-default), transparent) left / var(--igd-space-sm) 100% no-repeat scroll,
        linear-gradient(270deg, var(--igd-color-border-default), transparent) right / var(--igd-space-sm) 100% no-repeat scroll;
    }

    .sections a {
      border: var(--igd-border-width-default) solid var(--igd-color-border-default);
      border-radius: var(--igd-radius-action);
      white-space: nowrap;
    }

    li.sub a {
      padding-inline-start: var(--igd-space-inset-sm);
    }

    .sections a.current {
      border-color: var(--igd-color-background-tint);
    }
  }

  /* breakpoint-sm: the top bar scrolls away there, so the row sits at the top of the screen. */
  @media (max-width: 640px) {
    nav {
      inset-block-start: var(--notice-block-size, 0px);
    }
  }

  @media (pointer: coarse) {
    li a {
      align-items: center;
      min-block-size: var(--igd-size-control-lg);
    }
  }
</style>
