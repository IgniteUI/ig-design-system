---
// The section list of a page. It marks the section in view, and takes a control above the list through its slot.
interface Props {
  sections: { id: string; title: string; count?: number }[];
  back?: { href: string; title: string };
}

const { sections, back } = Astro.props;
---

<nav aria-label="Sections" data-section-nav>
  {back && <a class="back" href={back.href}>{back.title}</a>}
  <slot />
  <ul>
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`}>
            <span>{section.title}</span>
            {section.count !== undefined && <span class="count">{section.count}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import "@/scripts/scrollspy.ts";
</script>

<style>
  nav {
    position: sticky;
    inset-block-start: calc(var(--igd-nav-height) + var(--igd-space-stack-xl));
    align-self: start;
    scroll-target-group: auto;
  }

  .back {
    display: block;
    margin-block-end: var(--igd-space-stack-md);
    padding-inline: var(--igd-space-inset-sm);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--igd-space-gap-3xs);
  }

  li a {
    display: flex;
    justify-content: space-between;
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-sm);
    border-radius: var(--igd-radius-xs);
    color: var(--igd-color-text-secondary);
    font-size: var(--igd-type-body-sm-font-size);
  }

  li a:hover {
    color: var(--igd-color-text-heading);
    background: var(--igd-color-surface-muted);
  }

  /* The selected row of the docs site's sidebar: the action fill under its label. :is() keeps the rule valid where :target-current is unknown. */
  li a:is(:target-current, .target-current),
  li a:is(:target-current, .target-current):hover {
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-weight: var(--igd-font-weight-semibold);
  }

  li a:is(:target-current, .target-current) .count {
    color: inherit;
  }

  /* breakpoint-lg: one row under the top bar that stays in view and scrolls sideways. */
  @media (max-width: 1024px) {
    nav {
      inset-block-start: var(--igd-nav-height);
      z-index: var(--igd-z-index-sticky);
      margin-inline: calc(-1 * var(--igd-container-gutter));
      padding: var(--igd-space-inset-xs) var(--igd-container-gutter);
      background: var(--igd-nav-background);
      backdrop-filter: var(--igd-nav-backdrop-blur);
      border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-default);
    }

    .back {
      display: none;
    }

    ul {
      display: flex;
      gap: var(--igd-space-gap-2xs);
      overflow-x: auto;
      scrollbar-width: none;
    }

    li a {
      border: var(--igd-border-width-default) solid var(--igd-color-border-default);
      border-radius: var(--igd-radius-full);
      white-space: nowrap;
    }

    li a:is(:target-current, .target-current) {
      border-color: var(--igd-color-action-default);
    }
  }
</style>
