---
// The switch that says what a click on a name copies: the name ready for CSS, or the name alone. The choice is kept for the next page and visit.
import ToggleButton from "./ToggleButton.astro";
---

<div data-ig-scope class="format" role="group" aria-label="What a click on a name copies">
  <span>Copy as</span>
  <ToggleButton data-copy-format="css" aria-pressed="true">CSS</ToggleButton>
  <ToggleButton data-copy-format="name">Name</ToggleButton>
</div>

<script>
  import "@/scripts/copy.ts";
</script>

<style>
  .format {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--igd-space-gap-xs);
    margin-block-end: var(--igd-space-stack-md);
  }

  span {
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }
</style>
