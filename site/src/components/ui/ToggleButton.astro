---
// A pill button that is on or off. The script that owns it sets aria-pressed.
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;

const { "aria-pressed": pressed = "false", ...rest } = Astro.props;
---

<button data-ig-scope type="button" aria-pressed={pressed} {...rest}><slot /></button>

<style>
  button {
    min-block-size: var(--igd-size-control-sm);
    padding: var(--igd-space-inset-2xs) var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-action);
    background: transparent;
    color: var(--igd-color-foreground-control);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
  }

  @media (pointer: coarse) {
    button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  button[aria-pressed="true"] {
    background: var(--igd-color-background-action);
    border-color: var(--igd-color-background-action);
    color: var(--igd-color-foreground-on-action);
  }
</style>
