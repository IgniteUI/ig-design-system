---
// A name as a button that copies exactly the name it shows, with the prefix of the name dimmed and a copy mark after it.
interface Props {
  /** The text shown and copied. */
  name: string;
  /** The part at the start of `name` to dim, such as "--igd-". */
  prefix?: string;
}

const { name, prefix = "" } = Astro.props;
---

<button data-ig-scope type="button" data-copy={name} aria-label={`Copy ${name}`}>
  <span class="text"><span class="prefix">{prefix}</span>{name.slice(prefix.length)}</span>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
    <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path>
  </svg>
</button>

<script>
  import "@/scripts/copy.ts";
</script>

<style>
  button {
    display: inline-flex;
    align-items: center;
    gap: var(--igd-space-gap-2xs);
    justify-self: start;
    max-inline-size: 100%;
    min-block-size: var(--igd-space-xl);
    padding: var(--igd-space-inset-3xs) var(--igd-space-inset-2xs);
    margin-inline-start: calc(-1 * var(--igd-space-inset-2xs));
    border: 0;
    border-radius: var(--igd-radius-control);
    background: transparent;
    color: var(--igd-color-text-heading);
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-xs-font-size);
    text-align: start;
    cursor: copy;
  }

  button:hover {
    background: var(--igd-color-surface-tint);
  }

  /* A name breaks only after a hyphen, so a long one stays readable. */
  .text {
    overflow-wrap: break-word;
  }

  @media (pointer: coarse) {
    button {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  .prefix {
    color: var(--igd-color-text-muted);
  }

  svg {
    flex: none;
    inline-size: var(--igd-size-icon-xs);
    block-size: var(--igd-size-icon-xs);
    fill: none;
    stroke: var(--igd-color-text-muted);
    stroke-width: var(--igd-size-icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  button:hover svg {
    stroke: var(--igd-color-action-text);
  }
</style>
