---
// One use of the logo, right or wrong: the real file with a treatment applied, the verdict and the rule.
import LogoImage from "@/components/logo/LogoImage.astro";
import { SMALLEST } from "@/data/logo.ts";

interface Props {
  /** The treatment the picture applies to the logo. */
  treatment: string;
  ok: boolean;
  rule: string;
}

const { treatment, ok, rule } = Astro.props;
// The height of a logo that has text beside it: the logo-height token, or less in a narrow picture so the pair fits, and never under the smallest logo.
const beside = `max(${SMALLEST.logo}px, min(var(--igd-logo-height), 6cqi))`;
---

<li>
  <div class:list={["picture", { wrong: !ok }]} data-theme="light">
    {treatment === "on-dark" && <span class="plate" data-theme="dark"><LogoImage logo="dark" decorative /></span>}
    {treatment === "wrong-dark" && <span class="plate" data-theme="dark"><LogoImage logo="logo" decorative /></span>}
    {treatment === "busy" && <span class="plate busy"><LogoImage logo="logo" decorative /></span>}
    {treatment === "lockup" && <span class="lockup"><LogoImage logo="logo" height={beside} decorative /><span>Design system</span></span>}
    {treatment === "crowd" && <span class="crowd"><LogoImage logo="logo" height={beside} decorative /><span>Ignite UI</span></span>}
    {treatment === "retype" && <span class="retype"><LogoImage logo="mark" decorative /><span>INFRAGISTICS</span></span>}
    {
      ["plain", "stretch", "recolour", "rotate", "effect", "crop"].includes(treatment) && (
        <span class={treatment}><LogoImage logo="logo" decorative /></span>
      )
    }
  </div>
  <p><span class:list={["verdict", { dont: !ok }]}>{ok ? "Do" : "Don't"}</span> {rule}</p>
</li>

<style>
  li {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-xs);
  }

  p {
    margin: 0;
    color: var(--igd-color-text-secondary);
    font-size: var(--igd-type-body-sm-font-size);
    line-height: var(--igd-type-body-sm-line-height);
  }

  .picture {
    display: grid;
    place-items: center;
    min-block-size: var(--igd-space-6xl);
    padding: var(--igd-space-inset-lg);
    overflow: clip;
    container-type: inline-size;
    border: var(--igd-border-width-strong) solid var(--igd-color-feedback-success-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-page);
  }

  .picture.wrong {
    border-color: var(--igd-color-feedback-error-default);
  }

  .plate {
    display: grid;
    place-items: center;
    padding: var(--igd-space-inset-md) var(--igd-space-inset-lg);
    border-radius: var(--igd-radius-md);
    background: var(--igd-color-surface-inverse);
  }

  .plate.busy {
    background: var(--igd-gradient-brand);
  }

  .lockup,
  .crowd,
  .retype {
    display: flex;
    align-items: center;
    font-family: var(--igd-font-display);
    font-weight: var(--igd-font-weight-bold);
    color: var(--igd-color-text-heading);
    white-space: nowrap;
  }

  .lockup,
  .crowd {
    font-size: max(var(--igd-type-body-xs-font-size), min(var(--igd-type-title-md-font-size), 4.5cqi));
  }

  :is(.lockup, .crowd, .retype) :global(img) {
    flex: none;
  }

  .lockup {
    gap: var(--igd-space-gap-sm);
  }

  .lockup span {
    padding-inline-start: var(--igd-space-inset-sm);
    border-inline-start: var(--igd-border-width-default) solid var(--igd-color-border-control);
  }

  .crowd {
    gap: var(--igd-space-gap-3xs);
  }

  .retype {
    gap: var(--igd-space-gap-xs);
    font-size: var(--igd-type-title-md-font-size);
    color: var(--igd-color-text-muted);
  }

  .stretch :global(img) {
    transform: scaleX(0.6) scaleY(1.5);
  }

  .recolour :global(img) {
    filter: hue-rotate(140deg) saturate(1.6);
  }

  .rotate :global(img) {
    transform: rotate(-12deg);
  }

  .effect :global(img) {
    filter: drop-shadow(0 var(--igd-space-2xs) var(--igd-space-2xs) var(--igd-color-text-heading));
  }

  .crop {
    display: block;
    inline-size: 55%;
    overflow: clip;
  }

  .crop :global(img) {
    max-inline-size: none;
  }
</style>
