---
// The field that filters the tokens of the page by name or use, and the count of matches.
---

<input
  type="search"
  placeholder="Filter tokens, e.g. border"
  aria-label="Filter tokens by name or use"
  autocomplete="off"
  spellcheck="false"
  data-filter
/>
<span role="status" data-filter-matches></span>

<script>
  import "@/scripts/filter.ts";
</script>

<style>
  input {
    flex: 1;
    min-inline-size: var(--igd-field-min-width);
    max-inline-size: var(--igd-newsletter-min-width);
    min-block-size: var(--igd-size-control-md);
    padding: var(--igd-space-inset-2xs) var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-primary);
    font: inherit;
  }

  span {
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-body-sm-font-size);
  }
</style>
