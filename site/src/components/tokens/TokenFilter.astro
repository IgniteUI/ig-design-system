---
// The field that filters the tokens of the page by name, value or use, and the count of matches.
interface Props {
  /** The hint in the empty field. */
  placeholder?: string;
  /** The name of the field, for assistive technology. */
  label?: string;
}

const { placeholder = "Filter tokens, e.g. border", label = "Filter tokens by name, value or use" } = Astro.props;
---

<div data-ig-scope class="filter">
  <input type="search" placeholder={placeholder} aria-label={label} autocomplete="off" spellcheck="false" data-filter />
  <span role="status" data-filter-matches></span>
</div>

<script>
  import "@/scripts/filter.ts";
</script>

<style>
  .filter {
    display: grid;
    gap: var(--igd-space-gap-2xs);
    margin-block-end: var(--igd-space-stack-md);
  }

  input {
    inline-size: 100%;
    min-block-size: var(--igd-size-control-md);
    padding: var(--igd-space-inset-2xs) var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-strong);
    font: inherit;
  }

  span {
    padding-inline: var(--igd-space-inset-sm);
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-body-sm-font-size);
  }

  @media (pointer: coarse) {
    input {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  span:empty {
    display: none;
  }

  /* breakpoint-lg: no room under the field in the sticky row. */
  @media (max-width: 1024px) {
    .filter {
      margin-block-end: 0;
    }
  }
</style>
