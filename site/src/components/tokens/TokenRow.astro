---
// A token as a table row: its name as a copy button, a value, and a last cell for its note or a slot.
import CopyName from "@/components/ui/CopyName.astro";
import Note from "@/components/ui/Note.astro";
import Readout from "@/components/ui/Readout.astro";
import { cssVar, prefixOf, type Token } from "@/lib/design-system.ts";

interface Props {
  token: Token;
  /** The value shown: the token's own value as written, or its rendered length. */
  value: "written" | "length";
}

const { token, value } = Astro.props;
const custom = cssVar(token.name);
// A length written in rem, in pixels at the default text size of 16px.
const rem = token.value.match(/^(-?[\d.]+)rem$/);
const written = rem ? `${Math.round(Number(rem[1]) * 16 * 100) / 100}px (${token.value})` : token.value;
---

<tr data-ig-scope id={token.name} data-token={token.name} role="row">
  <th scope="row" role="rowheader"><CopyName name={custom} prefix={prefixOf(custom)} /></th>
  <td class="value" role="cell">{value === "length" ? <Readout token={token.name} kind="length" /> : written}</td>
  <td role="cell">
    <slot><Note text={token.usage} about={token.name} /></slot>
  </td>
</tr>
