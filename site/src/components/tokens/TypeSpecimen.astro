---
// A type role as a row: its class as a copy button, its rendered size, and a sample set in it.
import CopyName from "@/components/ui/CopyName.astro";
import Note from "@/components/ui/Note.astro";
import type { TypeStyle } from "@/lib/design-system.ts";

interface Props {
  style: TypeStyle;
  /** A plain use, shown in place of the role's own note. */
  use?: string;
  /** Shows the sample, its use, its class and its element, without the size, as the guide does. */
  plain?: boolean;
  /** The element the role is meant for, such as "h1". */
  element?: string;
}

const { style, use, plain = false, element } = Astro.props;
const className = `igd-${style.name}`;
---

<li data-ig-scope id={style.name} data-token={style.name} class:list={{ plain }}>
  {
    !plain && (
      <div class="spec">
        <CopyName name={`.${className}`} prefix=".igd-" />
        <output data-type={className} />
      </div>
    )
  }
  <div>
    <p class:list={["sample", className]} data-type-sample={className}>{style.sample}</p>
    {use ? <p class="use">{use}</p> : <Note text={style.usage} about={style.name} />}
    {
      plain && (
        <ul class="names" aria-label={`The class of ${style.name} and its element`}>
          <li>
            <CopyName name={`.${className}`} prefix=".igd-" />
          </li>
          {element && (
            <li class="element">
              on <code>{`<${element}>`}</code>
            </li>
          )}
        </ul>
      )
    }
  </div>
</li>

<script>
  import "@/scripts/readouts.ts";
</script>

<style>
  li {
    display: grid;
    grid-template-columns: var(--igd-field-min-width) minmax(0, 1fr);
    gap: var(--igd-space-gap-xl);
    padding-block: var(--igd-space-inset-lg);
    border-block-start: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
  }

  li.plain {
    grid-template-columns: minmax(0, 1fr);
  }

  output {
    display: block;
  }

  .use {
    margin: 0;
    color: var(--igd-color-foreground-subtle);
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--igd-space-gap-xs);
    gap: var(--igd-space-gap-3xs);
    margin: var(--igd-space-stack-xs) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--igd-type-body-xs-font-size);
  }

  /* The class and the element each stay on one line; the pair wraps as a whole. */
  .names li {
    display: block;
    flex: none;
    padding: 0;
    border: 0;
    white-space: nowrap;
  }

  .element {
    color: var(--igd-color-foreground-faint);
  }


  .sample {
    margin: 0 0 var(--igd-space-stack-xs);
    color: var(--igd-color-foreground-heading);
    overflow-wrap: anywhere;
  }

  @container (inline-size < 40rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--igd-space-gap-xs);
    }
  }
</style>
