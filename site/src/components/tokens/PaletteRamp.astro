---
// A family of the engine palette as one row: each step is a button that copies it, labelled in its contrast colour, with its value in its tooltip.
import { cssVar, type Token } from "@/lib/design-system.ts";

interface Props {
  family: string;
  steps: Token[];
}

const { family, steps } = Astro.props;
---

<li class="family-row" data-filter-group>
  <span class="family"><span>--ig-</span>{family}</span>
  <ol>
    {
      steps.map((step) => (
        <li data-token={step.name}>
          <button
            type="button"
            style={`background: var(${cssVar(step.name)}); color: var(${cssVar(`${step.name}-contrast`)})`}
            data-copy={`var(${cssVar(step.name)})`}
            data-copy-alt={cssVar(step.name)}
            data-colour-title={cssVar(step.name)}
            aria-label={`Copy var(${cssVar(step.name)})`}
          >
            {step.name.split("-").pop()}
          </button>
        </li>
      ))
    }
  </ol>
</li>

<script>
  import "@/scripts/copy.ts";
  import "@/scripts/readouts.ts";
</script>

<style>
  .family-row {
    display: grid;
    grid-template-columns: var(--igd-field-min-width) minmax(0, 1fr);
    align-items: center;
    gap: var(--igd-space-gap-md);
  }

  .family {
    white-space: nowrap;
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-xs-font-size);
  }

  .family span {
    color: var(--igd-color-text-muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-sm);
  }

  /* The ends of the row are rounded on the steps themselves, so nothing clips a focus ring. */
  ol li:first-child button {
    border-start-start-radius: var(--igd-radius-sm);
    border-end-start-radius: var(--igd-radius-sm);
  }

  ol li:last-child button {
    border-start-end-radius: var(--igd-radius-sm);
    border-end-end-radius: var(--igd-radius-sm);
  }

  button:focus-visible {
    position: relative;
  }

  button {
    inline-size: 100%;
    min-block-size: var(--igd-size-control-lg);
    border: 0;
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-2xs-font-size);
    cursor: copy;
  }

  @container (inline-size < 40rem) {
    .family-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--igd-space-gap-xs);
    }
  }
</style>
