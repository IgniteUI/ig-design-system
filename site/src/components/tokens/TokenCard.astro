---
// A token as a card, job first: its preview, what it is for, its name as a copy button, then its value.
// A plain use stands in for the token's own note.
import CopyName from "@/components/ui/CopyName.astro";
import Note from "@/components/ui/Note.astro";
import Readout from "@/components/ui/Readout.astro";
import { cssVar, prefixOf, SOURCE_LABEL, type Token } from "@/lib/design-system.ts";
import { href } from "@/lib/paths.ts";

interface Props {
  token: Token;
  /** How the preview is drawn: a fill, sample text, an outline, a shape that shows a corner, or a card lifted off the page. */
  preview: "fill" | "text" | "outline" | "shape" | "lifted";
  /** The CSS property of the preview that takes the token. */
  property: string;
  /** The rendered value shown with the name. */
  readout?: "colour" | "length";
  /** A plain use, shown first and in place of the token's own note. */
  use?: string;
  /** The token of the surface a text preview sits on. */
  on?: string;
  /** Show the value as it is written, for a token with no single rendered value, such as a shadow. */
  written?: boolean;
  /** Shows the preview and the use only, without the name and the value, as the guide does. */
  plain?: boolean;
  /** A short label after the name, such as "On dark only". */
  tag?: string;
}

const { token, preview, property, readout, use, on, written = false, plain = false, tag } = Astro.props;
const source = token.source;
// A token the source names, linked to its row; an engine step, to its place on the Engine page.
const tokenLink = (name: string) => href(`tokens/colour/#${name}`);
const custom = cssVar(token.name);
const style = [`${property}: var(${custom})`, on && `background: var(${cssVar(on)})`].filter(Boolean).join("; ");
---

<li data-ig-scope id={token.name} data-token={token.name}>
  <span class:list={["preview", preview, { on }]} style={style} aria-hidden="true">
    {preview === "text" && "Aa"}
  </span>
  {use ? <p class="use">{use}</p> : <Note text={token.usage} about={token.name} />}
  {!plain && <CopyName name={custom} prefix={prefixOf(custom)} />}
  {tag && <span class="tag">{tag}</span>}
  {!plain && readout && <Readout token={token.name} kind={readout} />}
  {written && <code class="written">{token.value}</code>}
  {
    !plain && source && (
      <p class="from">
        <span class:list={["origin", source.kind]}>{SOURCE_LABEL[source.kind]}</span>{" "}
        {source.kind === "step" && (
          <a href={href(`engine/#${source.step}`)}>
            <code>{cssVar(source.step)}</code>
          </a>
        )}
        {source.kind === "palette" && (
          <span>
            {source.palette} {source.step} <span class="hint">(not published)</span>
          </span>
        )}
        {source.kind === "token" && (
          <a href={tokenLink(source.token)}>
            <code>{source.token}</code>
          </a>
        )}
        {source.kind === "opacity" && (
          <span>
            <a href={tokenLink(source.token)}>
              <code>{source.token}</code>
            </a>{" "}
            at {source.percent}%
          </span>
        )}
        {source.kind === "contrast" && (
          <span>
            on{" "}
            <a href={tokenLink(source.on)}>
              <code>{source.on}</code>
            </a>
          </span>
        )}
        {token.follows && (
          <span class="follows">
            Follows{" "}
            <a href={tokenLink(token.follows)}>
              <code>{token.follows}</code>
            </a>
          </span>
        )}
      </p>
    )
  }
</li>

<style>
  li {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-3xs);
    padding: var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-tile);
    background: var(--igd-color-background-card);
  }

  li > :global(output) {
    display: block;
  }

  .use {
    margin: 0;
    color: var(--igd-color-foreground-default);
    font-weight: var(--igd-font-weight-semibold);
  }

  .written {
    color: var(--igd-color-foreground-subtle);
    overflow-wrap: anywhere;
  }

  .from {
    margin: 0;
    color: var(--igd-color-foreground-faint);
    font-size: var(--igd-type-body-xs-font-size);
    line-height: var(--igd-type-body-xs-line-height);
  }

  .preview {
    display: block;
    block-size: var(--igd-space-5xl);
    margin-block-end: var(--igd-space-stack-xs);
    border-radius: var(--igd-radius-badge);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
  }

  .text {
    display: grid;
    place-items: center;
    background: var(--igd-color-background-page);
    font-family: var(--igd-font-display);
    font-size: var(--igd-type-display-sm-font-size);
    font-weight: var(--igd-font-weight-bold);
  }

  .outline {
    background: var(--igd-color-background-page);
    border-width: var(--igd-focus-ring-width);
  }

  .shape {
    background: var(--igd-color-background-tint);
    border: var(--igd-border-width-strong) solid var(--igd-color-border-control);
  }

  .lifted {
    border-color: var(--igd-color-border-subtle);
    background: var(--igd-color-background-card);
    margin: var(--igd-space-stack-sm) var(--igd-space-gap-sm) var(--igd-space-stack-lg);
  }

  /* The list view: one row per token, the preview small, then the name, the use and the value side by side. */
  :global([data-view="list"]) li {
    grid-template-columns: var(--igd-size-control-sm) minmax(12rem, 18rem) minmax(0, 1fr) minmax(5rem, auto);
    align-items: center;
    column-gap: var(--igd-space-gap-md);
    padding: var(--igd-space-inset-xs) 0;
    border-width: 0 0 var(--igd-border-width-default);
    border-radius: 0;
    background: transparent;
  }

  :global([data-view="list"]) .preview {
    grid-column: 1;
    grid-row: 1 / span 2;
    block-size: var(--igd-size-control-sm);
    margin: 0;
    font-size: var(--igd-type-body-sm-font-size);
  }

  :global([data-view="list"]) li > :global(button[data-copy]) {
    grid-column: 2;
    grid-row: 1;
  }

  :global([data-view="list"]) li > :global(p:not(.from)) {
    grid-column: 3;
    grid-row: 1;
    margin: 0;
  }

  :global([data-view="list"]) li > :global(details) {
    grid-column: 3;
    grid-row: 2;
  }

  :global([data-view="list"]) li > :global(output) {
    grid-column: 4;
    grid-row: 1 / span 2;
  }

  :global([data-view="list"]) .from {
    grid-column: 2;
    grid-row: 2;
  }

  /* breakpoint-md: the name and the value share a line above the use. */
  @media (max-width: 768px) {
    :global([data-view="list"]) li {
      grid-template-columns: var(--igd-size-control-sm) minmax(0, 1fr) auto;
    }

    :global([data-view="list"]) li > :global(p:not(.from)) {
      grid-column: 2 / -1;
      grid-row: 3;
    }

    :global([data-view="list"]) li > :global(output) {
      grid-column: 3;
      grid-row: 1;
    }

    :global([data-view="list"]) li > :global(details) {
      grid-column: 2 / -1;
      grid-row: 4;
    }
  }

  /* A text colour is shown as "Aa" in that colour, with no box, unless it needs its dark surface behind it. */
  .preview.text:not(.on) {
    display: grid;
    place-items: center;
    border-color: transparent;
    background: transparent;
    font-family: var(--igd-font-display);
    font-size: var(--igd-type-title-md-font-size);
    font-weight: var(--igd-font-weight-bold);
  }

  .tag {
    justify-self: start;
    padding: 0 var(--igd-space-inset-xs);
    border-radius: var(--igd-radius-badge);
    background: var(--igd-color-background-inverse);
    color: var(--igd-color-foreground-inverse);
    font-size: var(--igd-type-body-2xs-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  :global([data-view="list"]) .tag {
    grid-column: 2;
    grid-row: 3;
  }

  /* Where a colour comes from, as a label: the same look for every kind, so a reader learns it once. */
  .origin {
    display: inline-block;
    margin-inline-end: var(--igd-space-gap-3xs);
    padding: 0 var(--igd-space-inset-xs);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-badge);
    color: var(--igd-color-foreground-subtle);
    font-size: var(--igd-type-body-2xs-font-size);
    font-weight: var(--igd-font-weight-semibold);
    letter-spacing: var(--igd-letter-spacing-badge);
    text-transform: uppercase;
  }

  .hint {
    color: var(--igd-color-foreground-faint);
  }

  .follows {
    display: block;
  }

  /* A name in a source stays on one line; the line breaks between words instead. */
  .from code {
    white-space: nowrap;
  }
</style>
