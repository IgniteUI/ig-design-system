---
// The document of every page: the head, the design system's stylesheets, the top bar and the toast.
import "@root/dist/fonts.css";
import "@root/dist/tokens.css";
import "@root/dist/theme.css";
import "@root/dist/base.css";
import "@/styles/global.css";
import DarkNotice from "@/components/layout/DarkNotice.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import Toast from "@/components/ui/Toast.astro";
import type { PageId } from "@/data/navigation.ts";

interface Props {
  /** The title of the page, without the name of the site. */
  title?: string;
  /** The page the top bar marks as open. A page the top bar does not list leaves it out. */
  current?: PageId;
  /** A page without the top bar, such as the landing page. */
  bare?: boolean;
}

const { title, current, bare = false } = Astro.props;
const SITE = "Infragistics design system";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title}: ${SITE}` : SITE}</title>
    <script is:inline>
      // Applies the stored theme before the first paint; with none stored the page is light.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("igd-theme");
        } catch {}
        document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to the content</a>
    <DarkNotice />
    {
      !bare && (
        <SiteHeader current={current}>
          <slot name="bar" slot="bar" />
          <slot name="switches" slot="switches" />
        </SiteHeader>
      )
    }
    <slot />
    <SiteFooter />
    <Toast />
  </body>
</html>

<style>
  /* Off screen until it takes keyboard focus. */
  .skip {
    position: absolute;
    inset-block-start: var(--igd-space-xs);
    inset-inline-start: var(--igd-space-xs);
    z-index: var(--igd-z-index-overlay);
    padding: var(--igd-space-inset-xs) var(--igd-space-inset-md);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-action-default);
    color: var(--igd-color-action-on);
    font-weight: var(--igd-font-weight-semibold);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }
</style>
