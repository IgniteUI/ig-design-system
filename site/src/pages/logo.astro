---
// The logo page: the files, their colours and proportion as read from the files, the surfaces a logo sits on, and the usage rules.
import Section from "@/components/layout/Section.astro";
import LogoImage from "@/components/logo/LogoImage.astro";
import SurfaceSample from "@/components/logo/SurfaceSample.astro";
import UsagePicture from "@/components/logo/UsagePicture.astro";
import CopyName from "@/components/ui/CopyName.astro";
import InfoCards from "@/components/ui/InfoCards.astro";
import Readout from "@/components/ui/Readout.astro";
import ScrollTable from "@/components/ui/ScrollTable.astro";
import {
  LOGO_COLOURS,
  LOGOS,
  MIN_CONTRAST,
  PROPORTION,
  SMALLEST,
  SURFACES,
  USAGES,
  WORDMARK_START,
} from "@/data/logo.ts";
import SectionsLayout from "@/layouts/SectionsLayout.astro";
import { cssVar, repository, tokens } from "@/lib/design-system.ts";
import { rgb } from "@/lib/logo.ts";
import { href } from "@/lib/paths.ts";
import { pick } from "@/lib/tokens.ts";

const sections = {
  files: { id: "files", title: "The logo" },
  anatomy: { id: "anatomy", title: "Anatomy" },
  colours: { id: "colours", title: "Colours" },
  backgrounds: { id: "backgrounds", title: "Backgrounds" },
  space: { id: "space", title: "Space and size" },
  rules: { id: "rules", title: "Do and don't" },
  type: { id: "type", title: "Typography" },
};

const colours: [hex: string, title: string, use: string][] = [
  [LOGO_COLOURS.blue, "Blue", "The square of the symbol. It is the same in every version."],
  [LOGO_COLOURS.white, "White", "The shape inside the square."],
  [LOGO_COLOURS.wordmark, "Gray", "The wordmark on a light surface."],
  [LOGO_COLOURS.darkWordmark, "Light gray", "The wordmark on a dark surface."],
];
// Stops the build on a surface that is not a colour token.
pick(tokens.color.tokens, SURFACES.map((s) => s.token), "colour");
const themes = [
  { theme: "light", title: "Light surfaces" },
  { theme: "dark", title: "Dark surfaces" },
] as const;
// Where the symbol ends and the wordmark starts, as a share of the width of the logo.
const symbolEnd = 100 / PROPORTION;
const wordStart = (100 * WORDMARK_START) / PROPORTION;
const heading = tokens.type.families.display.split(",")[0].replace(/'/g, "");
---

<SectionsLayout title="Logo" current="logo" sections={Object.values(sections)}>
  <h1>The Infragistics logo</h1>
  <p class="intro">Which file to use, on what, how large, and what never to do with it.</p>

  <Section {...sections.files}>
    <p class="intro">
      The Infragistics logo is a blue symbol and the name beside it. It comes in three files. Always use a
      file; never rebuild the logo.
    </p>
    <ul class="grid files">
      {
        Object.entries(LOGOS).map(([key, logo]) => (
          <li>
            <div
              class="surface"
              data-theme={logo.theme}
              style={`background: var(${cssVar(logo.theme === "dark" ? "color-surface-inverse" : "color-surface-page")})`}
            >
              <LogoImage logo={key as keyof typeof LOGOS} height="var(--igd-space-3xl)" />
            </div>
            <h3 class="plain">{logo.title}</h3>
            <p class="note">{logo.use}</p>
            <a class="download" href={logo.image.src} download={logo.file}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M4.5 7.5L8 11l3.5-3.5M3 13.5h10"></path></svg>
              Download {logo.file}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section {...sections.anatomy}>
    <p class="intro">Two parts with fixed sizes and a fixed distance. They scale together and never move.</p>
    <div class="anatomy" data-theme="light" aria-hidden="true">
      <div class="drawing">
        <LogoImage logo="logo" height="var(--igd-space-5xl)" decorative />
        <span class="part" style={`inline-size: ${symbolEnd}%`}>Symbol</span>
        <span class="part" style={`inset-inline-start: ${wordStart}%; inline-size: ${100 - wordStart}%`}>Wordmark</span>
      </div>
    </div>
    <ScrollTable label="Proportions of the logo">
      <tr>
        <th scope="row">Proportion</th>
        <td class="value">{PROPORTION} : 1</td>
        <td>The logo is {PROPORTION} times as wide as it is tall. Set the height and let the width follow.</td>
      </tr>
      <tr>
        <th scope="row">Symbol</th>
        <td class="value">square, blue</td>
        <td>As wide as the logo is tall. It also stands alone, as the logomark.</td>
      </tr>
      <tr>
        <th scope="row">Distance</th>
        <td class="value">{Math.round((WORDMARK_START - 1) * 100) / 100} of the height</td>
        <td>The gap between the symbol and the wordmark. It is part of the file.</td>
      </tr>
      <tr>
        <th scope="row">Wordmark</th>
        <td class="value">a drawing</td>
        <td>The name is drawn, not typed. No font reproduces it.</td>
      </tr>
    </ScrollTable>
  </Section>

  <Section {...sections.colours}>
    <p class="intro">
      The logo has four colours. These values are read from the logo files, so this list cannot differ from
      the logo.
    </p>
    <ul class="grid four">
      {
        colours.map(([hex, title, use]) => (
          <li class="colour">
            <span class="swatch" style={`background: ${hex}`} aria-hidden="true" />
            <strong>{title}</strong>
            <p class="note">{use}</p>
            <CopyName name={hex} />
            <CopyName name={`rgb(${rgb(hex)})`} />
          </li>
        ))
      }
    </ul>
    <p class="lead after">
      Do not use these values to colour a page. A page reads the design system's tokens; the logo keeps its
      own colours.
    </p>
  </Section>

  <Section {...sections.backgrounds}>
    <p class="intro">
      The logo sits on a plain surface of the design system. Light surfaces take the logo; dark surfaces take
      the logo for dark surfaces.
    </p>
    <p class="lead">
      The numbers are the contrast of each part against the surface, measured on this page. The wordmark needs
      at least {MIN_CONTRAST}:1 to be read, and one below it is marked. The blue square is a solid shape that
      is recognised by its form, so its number is for reference only.
    </p>
    {
      themes.map(({ theme, title }) => (
        <div class="group">
          <h3>{title}</h3>
          <ul class="grid four">
            {SURFACES.filter((s) => s.theme === theme).map((surface) => (
              <SurfaceSample {...surface} />
            ))}
          </ul>
        </div>
      ))
    }
    <p class="lead after">
      On a photo, a gradient or a colour that is not on this list, put the logo on a plain panel first.
    </p>
  </Section>

  <Section {...sections.space}>
    <p class="intro">Give the logo room, and keep it large enough to read.</p>
    <div class="clear" data-theme="light" aria-hidden="true">
      <span class="measure">x</span>
      <div class="zone">
        <span class="half top">½x</span>
        <span class="half side">½x</span>
        <LogoImage logo="logo" height="var(--igd-space-5xl)" decorative />
      </div>
      <span class="neighbour">The nearest text, picture or edge starts here.</span>
    </div>
    <p class="lead">
      In the drawing, x is the height of the logo. The dashed line is the clear space: half of x on every side.
    </p>
    <ScrollTable label="Clear space and smallest sizes">
      <tr>
        <th scope="row">Clear space</th>
        <td class="value">half the height</td>
        <td>
          Keep an empty margin of half the logo's height on every side. No text, picture or edge enters it.
          For a 24px logo that is 12px.
        </td>
      </tr>
      <tr>
        <th scope="row">On the website</th>
        <td class="value"><Readout token="logo-height" kind="length" /></td>
        <td>The height of the logo in the top bar, from the token <code>logo-height</code>.</td>
      </tr>
      <tr>
        <th scope="row">Smallest logo</th>
        <td class="value">{SMALLEST.logo}px tall</td>
        <td>Below it, use the logomark.</td>
      </tr>
      <tr>
        <th scope="row">Smallest logomark</th>
        <td class="value">{SMALLEST.mark}px</td>
        <td>The size of a favicon.</td>
      </tr>
    </ScrollTable>
    <div class="sizes" data-theme="light">
      {
        [40, 24, SMALLEST.logo].map((height) => (
          <div>
            <LogoImage logo="logo" height={`${height}px`} decorative />
            <span class="tag">{height}px</span>
          </div>
        ))
      }
      <div>
        <LogoImage logo="mark" height={`${SMALLEST.mark}px`} decorative />
        <span class="tag">{SMALLEST.mark}px logomark</span>
      </div>
    </div>
  </Section>

  <Section {...sections.rules}>
    <p class="intro">
      The logo is used as it is drawn. Each picture below is the real file; the wrong ones are changed on
      purpose.
    </p>
    <div class="group">
      <h3>Do</h3>
      <ul class="grid usage">{USAGES.filter((u) => u.ok).map((usage) => <UsagePicture {...usage} />)}</ul>
    </div>
    <div class="group">
      <h3>Don't</h3>
      <ul class="grid usage">{USAGES.filter((u) => !u.ok).map((usage) => <UsagePicture {...usage} />)}</ul>
    </div>
    <p class="lead after">
      A case these rules do not cover, such as a partner logo beside it or a photo behind it? Ask before it is
      published: <a href={`${repository}/issues/new`}>open an issue</a> and say where the logo goes.
    </p>
  </Section>

  <Section {...sections.type}>
    <p class="intro">
      The wordmark is a drawing, so the logo needs no font. Text that stands beside the logo uses the design
      system's typefaces.
    </p>
    <InfoCards
      items={[
        {
          title: "The wordmark",
          html: "Capital letters drawn for the logo and saved as shapes. Never retype it, and never set a headline to look like it.",
        },
        {
          title: "A name beside the logo",
          html: `${heading}, the heading typeface, as in the top bar of this page: the logo, a thin rule, the name.`,
        },
        {
          title: "Everything else",
          html: `Headlines and text follow the type roles of the design system. <a href="${href("#type")}">See Type in the guide.</a>`,
        },
      ]}
    />
  </Section>
</SectionsLayout>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--igd-field-min-width), 1fr));
    gap: var(--igd-space-gap-lg);
  }

  .grid > li {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-2xs);
  }

  .grid h3.plain {
    margin-block: var(--igd-space-stack-xs) 0;
  }

  .note {
    margin: 0;
    font-size: var(--igd-type-body-sm-font-size);
    line-height: var(--igd-type-body-sm-line-height);
    color: var(--igd-color-text-muted);
  }

  .lead.after {
    margin-block-start: var(--igd-space-stack-md);
  }

  .surface {
    display: grid;
    place-items: center;
    min-block-size: var(--igd-space-6xl);
    padding: var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-lg);
  }

  /* The three cards share their rows, so the downloads line up. */
  .files > li {
    grid-row: span 4;
    grid-template-rows: subgrid;
  }

  .download {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--igd-space-gap-xs);
    min-block-size: var(--igd-size-control-md);
    margin-block-start: var(--igd-space-stack-xs);
    padding-inline: var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
  }

  .download:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-text-heading);
  }

  .download svg {
    inline-size: var(--igd-size-icon-md);
    block-size: var(--igd-size-icon-md);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--igd-size-icon-stroke-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (pointer: coarse) {
    .download {
      min-block-size: var(--igd-size-control-lg);
    }
  }

  /* Wide enough for a logo with a name beside it. */
  .usage {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  /* Four of a kind sit in one row, or two by two. */
  .four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @container (inline-size < 48rem) {
    .four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .colour {
    padding: var(--igd-space-inset-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-md);
    background: var(--igd-color-surface-card);
  }

  .colour strong {
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  .swatch {
    display: block;
    block-size: var(--igd-space-5xl);
    margin-block-end: var(--igd-space-stack-xs);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-sm);
  }

  .anatomy,
  .clear {
    max-inline-size: 100%;
    margin-block: var(--igd-space-stack-xs) var(--igd-space-stack-lg);
    padding: var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-page);
  }

  .anatomy {
    display: inline-grid;
  }

  .drawing {
    position: relative;
    padding-block-end: var(--igd-space-inset-3xl);
  }

  /* A bracket under one part of the logo, with its name. */
  .part {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    block-size: var(--igd-space-2xl);
    padding-block-start: var(--igd-space-inset-xs);
    border: var(--igd-border-width-strong) solid var(--igd-color-border-control);
    border-block-start: 0;
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-2xs-font-size);
    line-height: 1;
    text-align: center;
    color: var(--igd-color-text-secondary);
    white-space: nowrap;
  }

  .clear {
    display: inline-grid;
    grid-template-columns: auto auto minmax(0, auto);
    align-items: center;
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-2xs-font-size);
    color: var(--igd-color-text-secondary);
  }

  /* The height of the logo, x: a line as tall as the logo. */
  .measure {
    display: grid;
    place-items: center;
    align-self: center;
    block-size: var(--igd-space-5xl);
    margin-inline-end: var(--igd-space-gap-sm);
    padding-inline-end: var(--igd-space-inset-xs);
    border-inline-end: var(--igd-border-width-strong) solid var(--igd-color-border-control);
  }

  /* Half the logo's height on every side, the clear space. */
  .zone {
    position: relative;
    padding: calc(var(--igd-space-inset-5xl) / 2);
    border: var(--igd-border-width-strong) dashed var(--igd-color-border-control);
    background: var(--igd-color-surface-tint);
  }

  .half {
    position: absolute;
    display: grid;
    place-items: center;
  }

  .half.top {
    inset: 0 0 auto;
    block-size: calc(var(--igd-space-5xl) / 2);
  }

  .half.side {
    inset: 0 auto 0 0;
    inline-size: calc(var(--igd-space-5xl) / 2);
  }

  .neighbour {
    max-inline-size: 14ch;
    padding-inline-start: var(--igd-space-inset-xs);
    font-family: var(--igd-font-body);
    font-size: var(--igd-type-body-sm-font-size);
    color: var(--igd-color-text-heading);
  }

  /* A narrow page puts the neighbour under the clear space. */
  @container (inline-size < 44rem) {
    .clear {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .neighbour {
      grid-column: 2;
      max-inline-size: none;
      padding: var(--igd-space-inset-2xs) 0 0;
    }
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--igd-space-gap-2xl);
    padding: var(--igd-space-inset-xl);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-page);
  }

  .sizes div {
    display: grid;
    gap: var(--igd-space-gap-xs);
  }
</style>
