---
// The Tokens page: every token a site may use, with its rendered value, and a filter to find one.
import Section from "@/components/layout/Section.astro";
import TokenCard from "@/components/tokens/TokenCard.astro";
import TokenFilter from "@/components/tokens/TokenFilter.astro";
import TokenGrid from "@/components/tokens/TokenGrid.astro";
import TokenRow from "@/components/tokens/TokenRow.astro";
import TypeSpecimen from "@/components/tokens/TypeSpecimen.astro";
import CopyFormat from "@/components/ui/CopyFormat.astro";
import ScrollTable from "@/components/ui/ScrollTable.astro";
import TypeSetToggle from "@/components/ui/TypeSetToggle.astro";
import SectionsLayout from "@/layouts/SectionsLayout.astro";
import { tokens } from "@/lib/design-system.ts";
import { href } from "@/lib/paths.ts";
import { COLOUR_GROUPS, engineOf, groupColours, isEngine, previewOf } from "@/lib/tokens.ts";

const { semantic, component } = groupColours(tokens.color.tokens);
const groups = [...COLOUR_GROUPS, ["other", "Other"] as [string, string]].filter(([key]) => semantic[key]);
const fromOf = (token: (typeof tokens.color.tokens)[number]) => engineOf(token, tokens.color.tokens);
const styles = tokens.type.groups.flatMap((g) => g.styles);
const roles = tokens.spacing.tokens.filter((t) => !isEngine(t.name));
const shadows = tokens.shadow.tokens.filter((t) => !isEngine(t.name));
const other = [
  ...tokens.opacity.tokens,
  ...tokens.weight.tokens,
  ...tokens.zIndex.tokens,
  ...tokens.breakpoint.tokens,
];
const property = { fill: "background", text: "color", outline: "border-color" };
// A colour of a label is shown as text on the fill it labels.
const LABELS: Record<string, string> = { "color-action-on": "color-action-default" };
// A text colour made for a dark surface is shown on one.
const surfaceOf = (name: string) => (name.includes("-inverse") ? "color-surface-inverse" : undefined);

const sections = {
  colour: { id: "colour", title: "Colour", count: Object.values(semantic).flat().length + component.length },
  type: { id: "type", title: "Type", count: styles.length, unit: "roles" },
  spacing: { id: "spacing", title: "Spacing", count: roles.length },
  radius: { id: "radius", title: "Radius", count: tokens.radius.tokens.length },
  shadow: { id: "shadow", title: "Shadow", count: shadows.length },
  gradient: { id: "gradient", title: "Gradient", count: tokens.gradient.tokens.length },
  size: { id: "size", title: "Size", count: tokens.size.tokens.length },
  other: { id: "other", title: "Opacity, weight, layers, breakpoints", count: other.length },
};
---

<SectionsLayout title="Tokens" current="tokens" sections={Object.values(sections)}>
  <TokenFilter slot="nav" />

  <h1>Tokens</h1>
  <div data-filter-rest>
  <p class="intro">Every token a site may use, with what it is for and the value it has on this page right now.</p>
  <dl class="tiers">
    <div>
      <dt>Use these</dt>
      <dd>
        Colour, Type, Spacing, Radius, Shadow, Gradient and Size. Each name says what the value is for, and a
        page or a component reads it.
      </dd>
    </div>
    <div>
      <dt>One component only</dt>
      <dd>Component colours. Each belongs to one part of the site, such as the footer or a badge.</dd>
    </div>
    <div>
      <dt>Do not use</dt>
      <dd>
        The palette, the raw spacing steps and the engine's elevations. The tokens are built from them, and they
        are on the <a href={href("engine/")}>Engine</a> page.
      </dd>
    </div>
  </dl>
  <p class="lead">
    Click a name to copy it. Choose CSS for a stylesheet, or Name for a design file or a brief. Press <kbd>/</kbd>
    to filter by name, value or use, and <kbd>Esc</kbd> to clear.
  </p>
  <CopyFormat />
  </div>

  <Section {...sections.colour}>
    <p class="intro">Site code uses these. A name says what the colour is for.</p>
    {
      groups.map(([key, title]) => (
        <div class="group" data-filter-group>
          <h3 id={`colour-${key}`}>{title}</h3>
          <TokenGrid>
            {semantic[key].map((token) => (
              <TokenCard
                token={token}
                preview={LABELS[token.name] ? "text" : previewOf(key)}
                property={property[LABELS[token.name] ? "text" : previewOf(key)]}
                readout="colour"
                on={LABELS[token.name] ?? (previewOf(key) === "text" ? surfaceOf(token.name) : undefined)}
                from={fromOf(token)}
              />
            ))}
          </TokenGrid>
        </div>
      ))
    }
    <h3 id="colour-component">Component colours</h3>
    <p class="lead">Each belongs to one part of the site. A page does not reuse it elsewhere.</p>
    <details class="group fold" data-filter-group>
      <summary>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5l4.5 4.5L6 12.5"></path></svg>
        <span class="closed">Show the {component.length} component colours</span>
        <span class="open">Hide the {component.length} component colours</span>
      </summary>
      <TokenGrid>
        {
          component.map((token) => (
            <TokenCard token={token} preview="fill" property="background" readout="colour" from={fromOf(token)} />
          ))
        }
      </TokenGrid>
    </details>
  </Section>

  <Section {...sections.type}>
    <p class="intro">
      {styles.length} roles. The readout is the size, line height and weight as rendered right now: resize the
      window or switch the type set.
    </p>
    <p class="lead">
      The marketing site uses the default sizes. A documentation page uses the smaller <code>docs</code> set: press
      the button to see it.
    </p>
    <p class="switches"><TypeSetToggle target="type-specimens" /></p>
    <ul class="specimens" id="type-specimens">{styles.map((style) => <TypeSpecimen style={style} />)}</ul>
  </Section>

  <Section {...sections.spacing}>
    <p class="intro">
      <code>space-inset-*</code> for padding, <code>space-stack-*</code> for vertical margins, <code
        >space-gap-*</code
      > for gaps. Each reads a <a href={href("engine/#spacing")}>raw step</a>.
    </p>
    <ScrollTable label="Spacing roles" head={["Role", "Value", "Use"]}>
      {roles.map((token) => <TokenRow token={token} value="length" />)}
    </ScrollTable>
  </Section>

  <Section {...sections.radius}>
    <p class="intro">Each role has a design value and a range it stays within.</p>
    <TokenGrid>
      {
        tokens.radius.tokens.map((token) => (
          <TokenCard token={token} preview="shape" property="border-radius" readout="length" />
        ))
      }
    </TokenGrid>
  </Section>

  <Section {...sections.shadow}>
    <p class="intro">
      Built from the engine's <a href={href("engine/#elevation")}>elevations</a>. The accent shadows and the tinted elevations take the action colour. In
      the dark variant of the theme surfaces separate by tone, so a shadow adds little there.
    </p>
    <TokenGrid roomy>
      {
        shadows.map((token) => (
          <TokenCard
            token={token}
            preview="lifted"
            property={token.name.endsWith("-filter") ? "filter" : "box-shadow"}
            written
          />
        ))
      }
    </TokenGrid>
  </Section>

  <Section {...sections.gradient}>
    <p class="intro">Three uses only: clipped headline text, the hero wash and glows, and the footer.</p>
    <TokenGrid>
      {tokens.gradient.tokens.map((token) => <TokenCard token={token} preview="fill" property="background" written />)}
    </TokenGrid>
  </Section>

  <Section {...sections.size}>
    <p class="intro">
      Control heights, icon sizes, widths and letter spacing. A length is shown in pixels at the default text
      size, with the value as written beside it.
    </p>
    <ScrollTable label="Size tokens" head={["Token", "Value", "Use"]}>
      {tokens.size.tokens.map((token) => <TokenRow token={token} value="written" />)}
    </ScrollTable>
  </Section>

  <Section {...sections.other}>
    <p class="intro">
      Four small scales: how see-through a layer is, how heavy text is, which layer sits on top, and the widths
      at which a layout changes.
    </p>
    <ScrollTable label="Opacity, weight, layer and breakpoint tokens" head={["Token", "Value", "Use"]}>
      {other.map((token) => <TokenRow token={token} value="written" />)}
    </ScrollTable>
  </Section>

  <p class="empty" hidden data-filter-empty>
    No token matches. Try a shorter word, such as <code>hover</code> or <code>inset</code>, or a value, such
    as <code>#155dfc</code> or <code>16px</code>.
  </p>
</SectionsLayout>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--igd-field-min-width), 1fr));
    gap: var(--igd-space-gap-xl);
    margin-block: 0 var(--igd-space-stack-lg);
    padding-block: var(--igd-space-inset-md);
    border-block: var(--igd-border-width-default) solid var(--igd-color-border-default);
  }

  .tiers dt {
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  .tiers dd {
    margin: 0;
    color: var(--igd-color-text-secondary);
    font-size: var(--igd-type-body-sm-font-size);
    line-height: var(--igd-type-body-sm-line-height);
  }

  [data-filter-rest] {
    margin-block-end: var(--igd-space-stack-3xl);
  }

  kbd {
    padding: 0 var(--igd-space-inset-2xs);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-xs);
    font-family: var(--igd-font-mono);
    font-size: var(--igd-type-body-xs-font-size);
  }

  .fold summary {
    display: inline-flex;
    align-items: center;
    gap: var(--igd-space-gap-xs);
    min-block-size: var(--igd-size-control-lg);
    margin-block-end: var(--igd-space-stack-sm);
    padding-inline: var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-full);
    color: var(--igd-color-text-ui);
    font-size: var(--igd-type-body-sm-font-size);
    font-weight: var(--igd-font-weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  .fold summary::-webkit-details-marker {
    display: none;
  }

  .fold summary:hover {
    background: var(--igd-color-surface-subtle);
    color: var(--igd-color-text-heading);
  }

  .fold svg {
    inline-size: var(--igd-size-icon-sm);
    block-size: var(--igd-size-icon-sm);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--igd-size-icon-stroke-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--igd-duration-fast) var(--igd-easing-default);
  }

  .fold[open] svg {
    rotate: 90deg;
  }

  .fold[open] .closed,
  .fold:not([open]) .open {
    display: none;
  }

  .switches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--igd-space-gap-xs);
    margin-block: 0 var(--igd-space-stack-md);
  }

  .specimens {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .empty {
    padding-block: var(--igd-space-inset-3xl);
    color: var(--igd-color-text-secondary);
  }
</style>
