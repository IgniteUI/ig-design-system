---
// The landing page: the logo, a welcome and one card per part of the site. It has no top bar; every other page does,
// and its logo leads back here.
import darkLogo from "@/assets/logos/ig-logo-dark.svg";
import logo from "@/assets/logos/ig-logo.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { href } from "@/lib/paths.ts";

const NEEDS = [
  { path: "guide/", title: "I need guidance", text: "Set up a site, build a component, and the rules to follow." },
  { path: "concepts/", title: "I want to explore", text: "Colour, type, space, corners and shadows, in plain words and live examples." },
  { path: "engine/", title: "I need to learn", text: "What the tokens are built from: the palette, the spacing steps and the elevations." },
  { path: "logo/", title: "I need an asset", text: "The logo files, their colours, and how to place them." },
  { path: "tokens/", title: "I am looking for a design token", text: "Every token by family, with one search across them all." },
];
---

<BaseLayout bare>
  <main id="content" tabindex="-1" data-ig-scope class="landing">
    <header class="welcome">
      <img class="logo light" src={logo.src} width={logo.width} height={logo.height} alt="Infragistics" />
      <img class="logo dark" src={darkLogo.src} width={darkLogo.width} height={darkLogo.height} alt="Infragistics" />
      <h1>The Infragistics design system</h1>
      <p class="intro">
        Every colour, size and space of the Infragistics sites has a name that says what it is for. These pages show
        what the system offers, in plain words and pictures. The names and values are on the{" "}
        <a href={href("tokens/")}>Tokens</a> page; how to build with it is in the <a href={href("guide/")}>Guide</a>.
      </p>
    </header>

    <section aria-labelledby="needs">
      <h2 id="needs">What do you need?</h2>
      <ul class="needs">
        {
          NEEDS.map((n) => (
            <li>
              <a href={href(n.path)}>
                <strong>{n.title}</strong>
                <span>{n.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .landing {
    display: grid;
    gap: var(--igd-space-gap-3xl);
    max-inline-size: var(--igd-container-max-width);
    margin-inline: auto;
    padding: var(--igd-space-section) var(--igd-container-gutter);
  }

  .landing:focus {
    outline: none;
  }

  .welcome {
    display: grid;
    justify-items: start;
    gap: var(--igd-space-gap-md);
  }

  /* A big logo, as wide as a short paragraph and never wider than the screen. */
  .logo {
    inline-size: min(100%, 32rem);
    block-size: auto;
    margin-block-end: var(--igd-space-stack-lg);
  }

  .welcome h1 {
    margin: 0;
  }

  .welcome .intro {
    margin: 0;
    max-inline-size: 44rem;
  }

  h2 {
    margin-block: 0 var(--igd-space-stack-md);
  }

  .needs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--igd-space-gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .needs a {
    display: grid;
    align-content: start;
    gap: var(--igd-space-gap-xs);
    block-size: 100%;
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-body);
    text-decoration: none;
    transition:
      border-color var(--igd-duration-fast) var(--igd-easing-default),
      box-shadow var(--igd-duration-fast) var(--igd-easing-default);
  }

  .needs a:hover {
    border-color: var(--igd-color-action-default);
    box-shadow: var(--igd-shadow-card-hover);
  }

  .needs strong {
    color: var(--igd-color-text-heading);
    font-size: var(--igd-type-title-sm-font-size);
  }

  /* The logo for the variant of the theme the page is in. */
  :global([data-theme="dark"]) .logo.light,
  :global([data-theme="light"]) .logo.dark {
    display: none;
  }
</style>
