---
// The overview of Tokens: which tokens a site uses, one card per family, and one search across every family.
import Section from "@/components/layout/Section.astro";
import { TOKEN_FAMILY_PAGES, type TokenFamilyId } from "@/data/navigation.ts";
import SectionsLayout from "@/layouts/SectionsLayout.astro";
import { cssVar, tokens } from "@/lib/design-system.ts";
import { href } from "@/lib/paths.ts";
import { lead, prose } from "@/lib/text.ts";
import { isEngine } from "@/lib/tokens.ts";

// The tokens of each family a site may write, as the family pages show them.
const MEMBERS: Record<TokenFamilyId, { name: string; value: string; usage: string }[]> = {
  colour: tokens.color.tokens.filter((t) => !isEngine(t.name)),
  type: tokens.type.groups.flatMap((g) =>
    g.styles.map((s) => ({ name: s.name, value: `.igd-${s.name}`, usage: s.usage })),
  ),
  spacing: tokens.spacing.tokens.filter((t) => !isEngine(t.name)),
  radius: tokens.radius.tokens,
  shadow: tokens.shadow.tokens.filter((t) => !isEngine(t.name)),
  gradient: tokens.gradient.tokens,
  size: tokens.size.tokens,
  other: [...tokens.opacity.tokens, ...tokens.weight.tokens, ...tokens.zIndex.tokens, ...tokens.breakpoint.tokens],
};
const results = TOKEN_FAMILY_PAGES.flatMap((f) =>
  MEMBERS[f.id].map((t) => ({
    ...t,
    label: f.id === "type" ? `.igd-${t.name}` : cssVar(t.name),
    family: f.title,
    href: href(`tokens/${f.id}/#${t.name}`),
  })),
);
// A few live samples on each family card.
const SAMPLES: Partial<Record<TokenFamilyId, string[]>> = {
  colour: ["color-action-default", "color-text-heading", "color-surface-tint", "color-feedback-success-default"],
  radius: ["radius-control", "radius-card", "radius-action"],
  shadow: ["shadow-card-hover"],
  gradient: ["gradient-brand"],
};
// The property a sample of each family shows its token in.
const SAMPLE_PROPERTY: Partial<Record<TokenFamilyId, string>> = {
  colour: "background",
  radius: "border-radius",
  shadow: "box-shadow",
  gradient: "background",
};
const sections = [
  { id: "search", title: "Search every token" },
  { id: "families", title: "The families" },
];
---

<SectionsLayout title="Tokens" sections={sections} menu="tokens">
  <h1>Tokens</h1>
  <p class="intro">
    Every token a site may use, by family, with what it is for and the value it has on the page right now. Each name
    says its job, not its look: <a href={href("concepts/#idea-names")}>why</a>.
  </p>
  <dl class="tiers">
    <div>
      <dt>Use these</dt>
      <dd>
        Colour, Type, Spacing, Radius, Shadow, Gradient and Size. Each name says what the value is for, and a page or
        a component reads it.
      </dd>
    </div>
    <div>
      <dt>One component only</dt>
      <dd>Component colours. Each belongs to one part of the site, such as the footer or a badge.</dd>
    </div>
    <div>
      <dt>Do not use</dt>
      <dd>
        The palette, the raw spacing steps and the engine's elevations. The tokens are built from them, and they are
        on the <a href={href("engine/")}>Engine</a> page.
      </dd>
    </div>
  </dl>

  <Section id="search" title="Search every token">
    <label class="search">
      <span class="sr">Search every token by name, value or use</span>
      <input type="search" placeholder="Search, e.g. hover or card" autocomplete="off" data-token-search />
    </label>
    <p class="count" aria-live="polite" data-token-search-count>
      {results.length} tokens in {TOKEN_FAMILY_PAGES.length} families.
    </p>
    <ul class="results" data-token-search-results>
      {
        results.map((r) => (
          <li hidden data-search={`${r.label} ${r.value} ${r.usage} ${r.family}`.toLowerCase()}>
            <a href={r.href}>
              <code>{r.label}</code>
            </a>
            <span class="family">{r.family}</span>
            <span class="usage" set:html={prose(lead(r.usage)[0])} />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="families" title="The families">
    <ul class="families">
      {
        TOKEN_FAMILY_PAGES.map((f) => (
          <li>
            <a href={href(`tokens/${f.id}/`)}>
              <span class="samples" aria-hidden="true">
                {(SAMPLES[f.id] ?? []).map((name) => (
                  <span class:list={["sample", f.id]} style={`${SAMPLE_PROPERTY[f.id]}: var(${cssVar(name)})`} />
                ))}
              </span>
              <strong>{f.title}</strong>
              <span class="members">{MEMBERS[f.id].length} tokens</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</SectionsLayout>

<script>
  import "@/scripts/token-search.ts";
</script>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--igd-field-min-width), 1fr));
    gap: var(--igd-space-gap-xl);
    margin-block: 0 var(--igd-space-stack-lg);
    padding-block: var(--igd-space-inset-md);
    border-block: var(--igd-border-width-default) solid var(--igd-color-border-default);
  }

  .tiers dt {
    color: var(--igd-color-text-heading);
    font-weight: var(--igd-font-weight-semibold);
  }

  .tiers dd {
    margin: 0;
    color: var(--igd-color-text-body);
    font-size: var(--igd-type-body-sm-font-size);
    line-height: var(--igd-type-body-sm-line-height);
  }

  .search input {
    inline-size: min(100%, 32rem);
    min-block-size: var(--igd-size-control-lg);
    padding-inline: var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-control);
    border-radius: var(--igd-radius-action);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-strong);
    font: inherit;
  }

  .count {
    margin-block: var(--igd-space-stack-xs) var(--igd-space-stack-md);
    color: var(--igd-color-text-muted);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .results {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results li {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(6rem, 8rem) minmax(0, 1fr);
    gap: var(--igd-space-gap-md);
    padding-block: var(--igd-space-inset-xs);
    border-block-end: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
    font-size: var(--igd-type-body-sm-font-size);
  }

  .results li[hidden] {
    display: none;
  }

  .results a {
    overflow-wrap: anywhere;
  }

  .family,
  .usage {
    color: var(--igd-color-text-body);
  }

  /* breakpoint-md */
  @media (max-width: 768px) {
    .results li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .usage {
      grid-column: 1 / -1;
    }
  }

  .families {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--igd-field-min-width), 1fr));
    gap: var(--igd-space-gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .families a {
    display: grid;
    gap: var(--igd-space-gap-2xs);
    block-size: 100%;
    padding: var(--igd-space-inset-md);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-card);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-body);
    text-decoration: none;
  }

  .families a:hover {
    border-color: var(--igd-color-action-default);
  }

  .families strong {
    color: var(--igd-color-text-heading);
  }

  .members {
    font-size: var(--igd-type-body-sm-font-size);
  }

  .samples {
    display: flex;
    gap: var(--igd-space-gap-2xs);
    min-block-size: var(--igd-size-control-sm);
    margin-block-end: var(--igd-space-stack-xs);
  }

  .sample {
    inline-size: var(--igd-size-control-sm);
    block-size: var(--igd-size-control-sm);
    border: var(--igd-border-width-default) solid var(--igd-color-border-subtle);
  }

  .colour {
    border-radius: var(--igd-radius-action);
  }

  .radius {
    background: var(--igd-color-surface-tint);
  }

  .shadow {
    border-radius: var(--igd-radius-control);
    background: var(--igd-color-surface-card);
  }

  .gradient {
    inline-size: 100%;
    border-radius: var(--igd-radius-control);
  }
</style>
