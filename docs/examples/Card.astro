---
// A card built on the design system. Copy it to start a component.
interface Props {
  title: string;
  href?: string;
}
const { title, href } = Astro.props;
---

<!-- data-ig-scope on the root: a dial set on any ancestor reaches this card. -->
<article class="card" data-ig-scope>
  <h3 class="card__title igd-type-title-sm">{title}</h3>
  <div class="card__body igd-type-body-md"><slot /></div>
  {href && <a class="card__link igd-type-label-md" href={href}>Read more</a>}
</article>

<style>
  .card {
    display: grid;
    /* Widths, heights and offsets are not tokens. */
    max-width: 24rem;
    /* Roles, not raw steps: inset for padding, gap for gaps, stack for vertical margins. */
    gap: var(--igd-space-gap-sm);
    padding: var(--igd-space-inset-lg);
    border: var(--igd-border-width-default) solid var(--igd-color-border-default);
    border-radius: var(--igd-radius-lg);
    background: var(--igd-color-surface-card);
    color: var(--igd-color-text-primary);
  }

  .card:hover {
    box-shadow: var(--igd-shadow-raised);
  }

  .card__title {
    margin: 0;
    color: var(--igd-color-text-heading);
  }

  /* Text in the action colour reads color-action-text; its hover is a token too. */
  .card__link {
    color: var(--igd-color-action-text);
  }

  .card__link:hover {
    color: var(--igd-color-action-hover);
  }
</style>
